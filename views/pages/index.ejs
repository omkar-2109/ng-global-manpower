            <div class="step-node">
              <div class="step-circle"><i class="fa-solid fa-stethoscope"></i></div>
              <div>
                <span class="step-time-label">Day 5–8</span>
                <h4 class="step-title">Medical & e-Visa</h4>
                <p class="step-desc">GAMCA medical test and electronic ministry visa approval submission.</p>
