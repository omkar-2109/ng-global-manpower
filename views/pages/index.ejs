<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/mobile-drawer') %>

<main>

  <!-- ==========================================================================
       1. HERO SECTION (JOB-FIRST & SEARCH DRIVEN)
       ========================================================================== -->
  <section class="hero-job-first">
    <div class="container" style="text-align: center; position: relative; z-index: 2;">
      
      <!-- Top Pulsing Active Jobs Badge -->
      <div>
        <div class="hero-job-badge-pill">
          <span class="pulse-dot-green"></span>
          <span><strong><%= (typeof stats !== 'undefined' && stats.totalActive) ? stats.totalActive : jobs.length %></strong> Verified Live Overseas Openings</span>
        </div>
      </div>

      <!-- Headline -->
      <h1 class="hero-job-headline">
        Find Verified <span class="gold-gradient-text">Overseas Jobs</span>
      </h1>

      <p class="hero-job-subhead">
        Direct employment quotas with accredited employers in the Gulf, Europe, USA, and New Zealand. Transparent regulated service charges with select 100% employer-funded positions.
      </p>

      <!-- Unified Modern Search Bar (Stripe UI Style) -->
      <form class="hero-search-bar" onsubmit="handleHeroSearch(event)">
        <div class="search-input-group">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="heroSearchInput" placeholder="Search job title, trade, skill (e.g. Welder, Driver, Electrician)..." oninput="handleHeroSearch(event)" />
        </div>

        <div class="search-divider"></div>

        <div class="search-select-group">
          <i class="fa-solid fa-earth-americas"></i>
          <select id="heroCountrySelect" onchange="handleHeroSearch(event)">
            <option value="">All Destination Countries</option>
            <option value="UAE">🇦🇪 United Arab Emirates</option>
            <option value="Saudi">🇸🇦 Saudi Arabia (KSA)</option>
            <option value="Qatar">🇶🇦 Qatar</option>
            <option value="Germany">🇩🇪 Germany & EU</option>
            <option value="United States">🇺🇸 United States (H-2B)</option>
            <option value="New Zealand">🇳🇿 New Zealand & Australia</option>
          </select>
        </div>

        <button type="submit" class="search-submit-btn">
          <span>Search Jobs</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <!-- Popular Country Quick Chips -->
      <div class="hero-country-chips">
        <span style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600; margin-right: 6px;">Top Destinations:</span>
        <button type="button" class="hero-country-chip" onclick="filterByCountryPill('UAE', this)">
          <span class="chip-flag">🇦🇪</span>
          <span>UAE</span>
        </button>
        <button type="button" class="hero-country-chip" onclick="filterByCountryPill('Germany', this)">
          <span class="chip-flag">🇩🇪</span>
          <span>Germany</span>
        </button>
        <button type="button" class="hero-country-chip" onclick="filterByCountryPill('Qatar', this)">
          <span class="chip-flag">🇶🇦</span>
          <span>Qatar</span>
        </button>
        <button type="button" class="hero-country-chip" onclick="filterByCountryPill('Saudi', this)">
          <span class="chip-flag">🇸🇦</span>
          <span>Saudi Arabia</span>
        </button>
        <button type="button" class="hero-country-chip" onclick="filterByCountryPill('United States', this)">
          <span class="chip-flag">🇺🇸</span>
          <span>USA</span>
        </button>
        <button type="button" class="hero-country-chip" onclick="filterByCountryPill('New Zealand', this)">
          <span class="chip-flag">🇳🇿</span>
          <span>New Zealand</span>
        </button>
      </div>

      <!-- Visual Trust Badges Strip -->
      <div class="trust-badges-strip">
        <div class="trust-badge-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>Government Registered</span>
        </div>
        <div class="trust-badge-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>Official Visa Guidance</span>
        </div>
        <div class="trust-badge-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>Verified Direct Employers</span>
        </div>
        <div class="trust-badge-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>Transparent Charges</span>
        </div>
        <div class="trust-badge-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>Anti-Fraud Advisory</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ==========================================================================
       2. LIVE JOBS DASHBOARD SECTION (GLOWING CARDS)
       ========================================================================== -->
  <section class="live-pulse-section">
    <div class="container">
      <div class="live-pulse-grid">
        
        <!-- Metric 1: Active Jobs -->
        <div class="live-pulse-card">
          <div class="pulse-card-header">
            <div class="pulse-card-icon pulse-icon-gold">
              <i class="fa-solid fa-briefcase"></i>
            </div>
            <span class="pulse-status-badge">
              <span class="pulse-dot-live"></span>
              <span>Live Database</span>
            </span>
          </div>
          <div class="pulse-card-value"><%= (typeof stats !== 'undefined' && stats.totalActive) ? stats.totalActive : jobs.length %></div>
          <p class="pulse-card-label">Active Verified Overseas Jobs</p>
        </div>

        <!-- Metric 2: New Today -->
        <div class="live-pulse-card">
          <div class="pulse-card-header">
            <div class="pulse-card-icon pulse-icon-blue">
              <i class="fa-solid fa-bolt"></i>
            </div>
            <span class="pulse-status-badge" style="color: #BAE6FD;">
              <i class="fa-solid fa-clock"></i> Last 24 Hours
            </span>
          </div>
          <div class="pulse-card-value"><%= (typeof stats !== 'undefined' && stats.newToday) ? stats.newToday : 3 %></div>
          <p class="pulse-card-label">New Quotas Received Today</p>
        </div>

        <!-- Metric 3: Countries -->
        <div class="live-pulse-card">
          <div class="pulse-card-header">
            <div class="pulse-card-icon pulse-icon-purple">
              <i class="fa-solid fa-earth-americas"></i>
            </div>
            <span class="pulse-status-badge" style="color: #E9D5FF;">
              Global Network
            </span>
          </div>
          <div class="pulse-card-value"><%= (typeof stats !== 'undefined' && stats.countriesCount) ? stats.countriesCount : 6 %></div>
          <p class="pulse-card-label">Overseas Destination Countries</p>
        </div>

        <!-- Metric 4: Sponsored Jobs -->
        <div class="live-pulse-card">
          <div class="pulse-card-header">
            <div class="pulse-card-icon pulse-icon-green">
              <i class="fa-solid fa-gift"></i>
            </div>
            <span class="pulse-status-badge" style="color: #6EE7B7;">
              Zero Fee Quotas
            </span>
          </div>
          <div class="pulse-card-value"><%= (typeof stats !== 'undefined' && stats.sponsoredCount) ? stats.sponsoredCount : 2 %></div>
          <p class="pulse-card-label">100% Employer-Funded Openings</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ==========================================================================
       3. POPULAR CATEGORIES (INTERACTIVE QUICK FILTERS)
       ========================================================================== -->
  <section class="popular-categories-section">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px;">
        <div>
          <div class="section-badge" style="background: rgba(212, 175, 55, 0.12); border-color: var(--border-gold); color: var(--gold-300);">
            <i class="fa-solid fa-layer-group"></i>
            <span>Browse By Trade</span>
          </div>
          <h2 class="section-title" style="margin-bottom: 0;">Popular <span class="gold-gradient-text">Job Categories</span></h2>
        </div>
        <button type="button" class="btn btn-secondary" style="font-size: 0.88rem; padding: 8px 16px;" onclick="filterJobsLive('', '', '')">
          <i class="fa-solid fa-rotate-left"></i>
          <span>Reset All Filters</span>
        </button>
      </div>

      <div class="popular-categories-grid">
        
        <!-- Category 1: Construction -->
        <div class="category-chip-card" onclick="filterByCategoryPill('Construction', this)">
          <div class="category-chip-icon"><i class="fa-solid fa-trowel-bricks"></i></div>
          <h3 class="category-chip-title">Construction</h3>
          <span class="category-chip-count">Helpers, Riggers, Steel</span>
        </div>

        <!-- Category 2: Drivers -->
        <div class="category-chip-card" onclick="filterByCategoryPill('Logistics', this)">
          <div class="category-chip-icon"><i class="fa-solid fa-truck-fast"></i></div>
          <h3 class="category-chip-title">Drivers</h3>
          <span class="category-chip-count">Heavy, Trailer & Tanker</span>
        </div>

        <!-- Category 3: Warehouse -->
        <div class="category-chip-card" onclick="filterByCategoryPill('Warehouse', this)">
          <div class="category-chip-icon"><i class="fa-solid fa-warehouse"></i></div>
          <h3 class="category-chip-title">Warehouse</h3>
          <span class="category-chip-count">Loaders, Logistics, Forklift</span>
        </div>

        <!-- Category 4: Hospitality -->
        <div class="category-chip-card" onclick="filterByCategoryPill('Hospitality', this)">
          <div class="category-chip-icon"><i class="fa-solid fa-utensils"></i></div>
          <h3 class="category-chip-title">Hospitality</h3>
          <span class="category-chip-count">Chefs, Resort Crew, Waiters</span>
        </div>

        <!-- Category 5: Oil & Gas -->
        <div class="category-chip-card" onclick="filterByCategoryPill('Oil & Gas', this)">
          <div class="category-chip-icon"><i class="fa-solid fa-gas-pump"></i></div>
          <h3 class="category-chip-title">Oil & Gas</h3>
          <span class="category-chip-count">Refinery, Valve, Piping</span>
        </div>

        <!-- Category 6: Manufacturing -->
        <div class="category-chip-card" onclick="filterByCategoryPill('Manufacturing', this)">
          <div class="category-chip-icon"><i class="fa-solid fa-industry"></i></div>
          <h3 class="category-chip-title">Manufacturing</h3>
          <span class="category-chip-count">6G Welders, Mechanics, CNC</span>
        </div>

      </div>
    </div>
  </section>

  <!-- ==========================================================================
       4. LIVE OPENINGS (JOB CARDS ARE THE HERO)
       ========================================================================== -->
  <section id="live-openings" class="section-spacing" style="padding-top: 20px;">
    <div class="container">
      
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; margin-bottom: 28px;">
        <div>
          <div class="section-badge" style="background: rgba(16, 185, 129, 0.12); border-color: rgba(16, 185, 129, 0.35); color: #34D399;">
            <i class="fa-solid fa-fire"></i>
            <span>Featured International Openings</span>
          </div>
          <h2 class="section-title">Latest Verified <span class="gold-gradient-text">Job Vacancies</span></h2>
          <p class="section-subtitle" style="margin: 0;">
            Apply directly with our 5-step quick candidate intake. Opens immediately with the recruiter on WhatsApp.
          </p>
        </div>

        <div style="display: flex; align-items: center; gap: 14px;">
          <span id="liveJobsCountLabel" style="font-family: var(--font-mono); font-size: 0.9rem; color: var(--gold-light); font-weight: 700;">
            <%= jobs.length %> openings available
          </span>
          <a href="/jobs" class="btn btn-secondary" style="padding: 10px 18px; font-size: 0.9rem;">
            <span>View All Jobs &rarr;</span>
          </a>
        </div>
      </div>

      <!-- Hero Job Cards Grid -->
      <div class="job-cards-hero-grid" id="liveJobsGrid">
        <% if (jobs && jobs.length > 0) { %>
          <% jobs.forEach(job => { %>
            <div class="job-card-premium job-filter-target" 
                 data-title="<%= job.title %>" 
                 data-country="<%= job.country %>" 
                 data-category="<%= job.category %>">
              
              <!-- Card Photo Header -->
              <a href="/jobs/<%= job.job_code || job.id %>" class="card-photo-header" style="display: block; text-decoration: none;">
                <img src="<%= job.image || '/images/corporate_hero_bg.jpg' %>" alt="<%= job.title %> in <%= job.country %>" loading="lazy" />
                <div class="card-photo-overlay">
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="card-country-flag-badge">
                      <span><%= job.flag || '🌐' %></span>
                      <span><%= job.country.split('(')[0].trim() %></span>
                    </span>
                    <% if (job.employer_funded) { %>
                      <span class="card-fee-pill sponsored"><i class="fa-solid fa-gift"></i> 100% Free Quota</span>
                    <% } else { %>
                      <span class="card-fee-pill standard"><i class="fa-solid fa-shield-halved"></i> Regulated Fee</span>
                    <% } %>
                  </div>
                  <div>
                    <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--gold-300); background: rgba(0,0,0,0.65); padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(212,175,55,0.3);">
                      Ref: <%= job.job_code %>
                    </span>
                  </div>
                </div>
              </a>

              <!-- Card Content -->
              <div class="job-card-content">
                <div>
                  <a href="/jobs/<%= job.job_code || job.id %>" style="text-decoration: none; color: inherit;">
                    <h3 style="font-size: 1.25rem; font-weight: 700; color: #fff; margin: 0 0 6px 0; line-height: 1.35; transition: color 0.2s ease;">
                      <%= job.title %>
                    </h3>
                  </a>
                  <div style="font-size: 0.82rem; color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
                    <i class="fa-solid fa-wrench" style="color: var(--gold-amber);"></i>
                    <span><%= job.category %></span>
                  </div>

                  <!-- Salary Badge -->
                  <div class="salary-badge-glow">
                    <span><%= job.salary_foreign || job.salary_inr %></span>
                    <span style="font-size: 0.82rem; color: #BAE6FD; font-weight: 600; font-family: var(--font-body); margin-left: 6px;">
                      (<%= job.salary_inr.split('/')[0].trim() %>)
                    </span>
                  </div>

                  <!-- Key Perks -->
                  <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 20px;">
                    <% (job.perks || []).slice(0, 3).forEach(perk => { %>
                      <span style="background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.08); color: #CBD5E1; padding: 4px 9px; border-radius: 8px; font-size: 0.78rem;">
                        <i class="fa-solid fa-check" style="color: #10B981; margin-right: 4px;"></i> <%= perk %>
                      </span>
                    <% }); %>
                  </div>
                </div>

                <!-- Apply Trigger & View Details -->
                <div style="display: flex; gap: 8px;">
                  <a href="/jobs/<%= job.job_code || job.id %>" class="btn btn-secondary" style="flex: 1; justify-content: center; padding: 12px 10px; font-size: 0.88rem; border-radius: 12px; border-color: rgba(255,255,255,0.2);">
                    <i class="fa-solid fa-circle-info"></i>
                    <span>Details</span>
                  </a>
                  <button type="button" class="btn btn-gold" style="flex: 1.3; justify-content: center; padding: 12px 10px; font-size: 0.88rem; border-radius: 12px;" 
                          data-job-code="<%= job.job_code %>" 
                          data-job-title="<%= job.title %>" 
                          data-job-country="<%= job.country %>" 
                          data-job-salary="<%= job.salary_foreign || job.salary_inr %>" 
                          data-job-category="<%= job.category %>" 
                          onclick="triggerJobApply(this)">
                    <i class="fa-brands fa-whatsapp" style="font-size: 1.05rem;"></i>
                    <span>Apply</span>
                  </button>
                </div>
              </div>

            </div>
          <% }); %>
        <% } else { %>
          <div class="glass-card" style="grid-column: 1 / -1; text-align: center; padding: 60px 24px; border-radius: 20px; background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.08);">
            <i class="fa-solid fa-briefcase" style="font-size: 3rem; color: var(--gold-amber); margin-bottom: 16px; opacity: 0.85;"></i>
            <h3 style="font-size: 1.35rem; color: #fff; margin-bottom: 8px;">No Active Overseas Openings Right Now</h3>
            <p style="color: var(--text-muted); max-width: 520px; margin: 0 auto 24px auto; font-size: 0.95rem; line-height: 1.6;">
              New verified international vacancies are published directly by our HR recruitment operations desk. You can submit your candidate profile to get instantly matched once suitable employer quotas open.
            </p>
            <a href="#lead-funnel" class="btn btn-gold" style="display: inline-flex; padding: 12px 24px;">
              <span>Submit Candidate Profile</span>
              <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
        <% } %>
      </div>

      <!-- No Results Feedback State -->
      <div id="liveJobsNoResults" class="glass-card" style="display: none; text-align: center; padding: 60px 24px; margin-top: 24px; border-radius: 20px;">
        <i class="fa-solid fa-magnifying-glass" style="font-size: 3rem; color: var(--gold-primary); margin-bottom: 16px;"></i>
        <h3 style="font-size: 1.35rem; color: #fff; margin-bottom: 8px;">No Openings Match Your Filter</h3>
        <p style="color: var(--text-muted); max-width: 480px; margin: 0 auto 20px auto;">
          Try adjusting your search terms or clearing your country and trade filters to see all available international vacancies.
        </p>
        <button type="button" class="btn btn-gold" onclick="filterJobsLive('', '', '')">Show All Openings</button>
      </div>

    </div>
  </section>

  <!-- ==========================================================================
       5. INTERACTIVE WORLD MAP & REGIONAL HUB (REPLACING 3D GLOBE)
       ========================================================================== -->
  <section id="world-map-hub" class="regional-hub-section">
    <div class="container">
      
      <div class="section-header" style="text-align: center; margin-bottom: 30px;">
        <div class="section-badge" style="background: rgba(56, 189, 248, 0.12); border-color: rgba(56, 189, 248, 0.35); color: #38BDF8;">
          <i class="fa-solid fa-map-location-dot"></i>
          <span>Global Deployment Hubs</span>
        </div>
        <h2 class="section-title">Explore Jobs by <span class="gold-gradient-text">World Region</span></h2>
        <p class="section-subtitle" style="max-width: 680px; margin: 0 auto;">
          Direct recruitment programs across four dedicated overseas hubs. Select your target region to filter live openings.
        </p>
      </div>

      <div class="regional-hub-layout">
        
        <!-- Left: Stylized Interactive SVG World Map -->
        <div class="world-map-svg-container">
          <svg viewBox="0 0 1000 500" class="world-map-svg" xmlns="http://www.w3.org/2000/svg">
            <defs>
              <radialGradient id="mapBg" cx="50%" cy="50%" r="60%">
                <stop offset="0%" stop-color="#0D1F4A" stop-opacity="1"/>
                <stop offset="100%" stop-color="#030A1A" stop-opacity="1"/>
              </radialGradient>
              <filter id="nodeGlow" x="-80%" y="-80%" width="260%" height="260%">
                <feGaussianBlur stdDeviation="4" result="glow"/>
                <feMerge><feMergeNode in="glow"/><feMergeNode in="SourceGraphic"/></feMerge>
              </filter>
              <filter id="continentShadow" x="-5%" y="-5%" width="110%" height="110%">
                <feDropShadow dx="0" dy="2" stdDeviation="3" flood-color="#000" flood-opacity="0.5"/>
              </filter>
              <style>
                .continent { stroke-linejoin: round; stroke-linecap: round; }
                @keyframes nodePulse { 0%,100%{r:14;opacity:0.6} 50%{r:20;opacity:0.15} }
                .node-ring { animation: nodePulse 2.5s infinite ease-in-out; }
                @keyframes dashMove { from{stroke-dashoffset:0} to{stroke-dashoffset:-24} }
                .arc-line { animation: dashMove 2s linear infinite; }
              </style>
            </defs>

            <!-- Ocean background -->
            <rect width="1000" height="500" fill="url(#mapBg)"/>
            <!-- Latitude grid lines -->
            <line x1="0" y1="125" x2="1000" y2="125" stroke="rgba(56,189,248,0.06)" stroke-width="0.8"/>
            <line x1="0" y1="250" x2="1000" y2="250" stroke="rgba(56,189,248,0.06)" stroke-width="0.8"/>
            <line x1="0" y1="375" x2="1000" y2="375" stroke="rgba(56,189,248,0.06)" stroke-width="0.8"/>
            <!-- Longitude grid lines -->
            <line x1="250" y1="0" x2="250" y2="500" stroke="rgba(56,189,248,0.06)" stroke-width="0.8"/>
            <line x1="500" y1="0" x2="500" y2="500" stroke="rgba(56,189,248,0.06)" stroke-width="0.8"/>
            <line x1="750" y1="0" x2="750" y2="500" stroke="rgba(56,189,248,0.06)" stroke-width="0.8"/>
            <!-- Equator -->
            <line x1="0" y1="265" x2="1000" y2="265" stroke="rgba(56,189,248,0.12)" stroke-width="1" stroke-dasharray="6,6"/>

            <!-- ===== CONTINENTS ===== -->
            <!-- North America -->
            <path class="continent" d="M 95 55 L 115 50 L 140 45 L 175 50 L 200 48 L 215 55 L 220 65 L 210 72 L 218 78 L 215 90 L 205 98 L 196 108 L 200 118 L 192 128 L 188 140 L 178 148 L 175 160 L 165 168 L 162 178 L 155 185 L 148 195 L 138 210 L 130 225 L 122 240 L 118 255 L 112 268 L 105 278 L 95 285 L 88 278 L 92 268 L 98 258 L 96 245 L 90 240 L 85 232 L 80 225 L 78 215 L 82 205 L 88 195 L 90 185 L 85 178 L 78 170 L 72 160 L 70 148 L 68 135 L 72 122 L 75 110 L 72 98 L 70 88 L 75 78 L 82 68 L 90 60 Z" fill="#0C2A5F" stroke="rgba(56,189,248,0.3)" stroke-width="1.2" filter="url(#continentShadow)"/>
            <!-- Alaska/Canada extension -->
            <path class="continent" d="M 95 55 L 85 48 L 70 42 L 55 38 L 45 42 L 40 50 L 45 58 L 55 62 L 65 60 L 75 58 L 85 55 Z" fill="#0C2A5F" stroke="rgba(56,189,248,0.25)" stroke-width="1"/>
            <!-- Greenland -->
            <path class="continent" d="M 195 25 L 215 20 L 235 22 L 248 30 L 252 42 L 245 52 L 230 58 L 218 55 L 205 48 L 198 38 Z" fill="#0A2250" stroke="rgba(56,189,248,0.2)" stroke-width="1"/>
            <!-- Central America & Caribbean -->
            <path class="continent" d="M 138 210 L 148 215 L 155 218 L 158 228 L 155 235 L 148 240 L 142 235 L 138 225 Z" fill="#0C2A5F" stroke="rgba(56,189,248,0.2)" stroke-width="1"/>
            <!-- South America -->
            <path class="continent" d="M 200 268 L 215 262 L 228 265 L 240 272 L 250 282 L 255 295 L 260 310 L 262 325 L 258 340 L 252 355 L 242 370 L 230 382 L 218 390 L 208 395 L 198 392 L 188 385 L 180 375 L 175 360 L 172 345 L 175 330 L 180 318 L 178 305 L 175 292 L 178 280 L 185 272 Z" fill="#0A1E48" stroke="rgba(56,189,248,0.25)" stroke-width="1.2" filter="url(#continentShadow)"/>

            <!-- Europe (highlighted - has hiring) -->
            <path class="continent" d="M 445 85 L 458 80 L 472 78 L 485 82 L 498 80 L 512 78 L 525 82 L 530 92 L 528 102 L 520 110 L 518 120 L 512 128 L 505 132 L 498 128 L 492 135 L 485 140 L 478 135 L 472 128 L 465 122 L 458 118 L 452 112 L 448 105 L 445 98 Z" fill="#1A4080" stroke="rgba(212,175,55,0.55)" stroke-width="1.8" filter="url(#continentShadow)"/>
            <!-- Scandinavia -->
            <path class="continent" d="M 480 58 L 492 52 L 505 55 L 512 62 L 510 72 L 505 78 L 498 80 L 490 75 L 482 68 Z" fill="#143368" stroke="rgba(212,175,55,0.4)" stroke-width="1.2"/>
            <!-- UK & Ireland -->
            <path class="continent" d="M 432 88 L 438 84 L 442 90 L 440 98 L 435 102 L 430 98 L 430 92 Z" fill="#143368" stroke="rgba(212,175,55,0.35)" stroke-width="1"/>

            <!-- Africa -->
