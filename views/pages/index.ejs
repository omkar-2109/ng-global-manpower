<%- include('../partials/head') %>
<%- include('../partials/navbar') %>
<%- include('../partials/mobile-drawer') %>

<main>

  <!-- ==========================================================================
       1. HERO SECTION (JOB-FIRST & SEARCH DRIVEN)
       ========================================================================== -->
  <section class="hero-job-first">
    <div class="container" style="text-align: center; position: relative; z-index: 2;">
      
      <!-- Top Pulsing Active Jobs Badge -->
      <div>
        <div class="hero-job-badge-pill">
          <span class="pulse-dot-green"></span>
          <span><strong><%= (typeof stats !== 'undefined' && stats.totalActive) ? stats.totalActive : jobs.length %></strong> Verified Live Overseas Openings</span>
        </div>
      </div>

      <!-- Headline -->
      <h1 class="hero-job-headline">
        Find Verified <span class="gold-gradient-text">Overseas Jobs</span>
      </h1>

      <p class="hero-job-subhead">
        Direct company vacancies with accredited infrastructure, industrial, and engineering employers across the Gulf, Europe, USA, and New Zealand. Company-provided accommodation, food allowances, and direct interview coordination.
      </p>

      <!-- 3 Primary Hero CTA Action Buttons -->
      <div class="hero-primary-ctas" style="display: flex; justify-content: center; gap: 12px; flex-wrap: wrap; margin: 20px 0 28px 0;">
        <a href="#live-openings" class="btn btn-gold hero-cta-btn" style="padding: 13px 22px; font-size: 0.95rem;">
          <i class="fa-solid fa-briefcase"></i>
          <span>View Verified Openings</span>
        </a>
        <a href="#lead-funnel" class="btn btn-secondary hero-cta-btn" style="padding: 13px 22px; font-size: 0.95rem;">
          <i class="fa-solid fa-bolt"></i>
          <span>Check Eligibility Online</span>
        </a>
        <a href="https://wa.me/<%= typeof settings !== 'undefined' && settings.whatsappNumber ? settings.whatsappNumber : '918080025670' %>?text=Hello%20NG%20Global%20HR,%20I%20want%20to%20apply%20for%20overseas%20jobs.%20Please%20guide%20me." target="_blank" class="btn btn-whatsapp hero-cta-btn" style="padding: 13px 22px; font-size: 0.95rem;">
          <i class="fa-brands fa-whatsapp"></i>
          <span>WhatsApp HR</span>
        </a>
      </div>

      <!-- Unified Modern Search Bar (Stripe UI Style) -->
      <form class="hero-search-bar" onsubmit="handleHeroSearch(event)">
        <div class="search-input-group">
          <i class="fa-solid fa-magnifying-glass"></i>
          <input type="text" id="heroSearchInput" placeholder="Search job title, trade, skill (e.g. Welder, Driver, Electrician)..." oninput="handleHeroSearch(event)" />
        </div>

        <div class="search-divider"></div>

        <div class="search-select-group">
          <i class="fa-solid fa-earth-americas"></i>
          <select id="heroCountrySelect" onchange="handleHeroSearch(event)">
            <option value="">All Destination Countries</option>
            <option value="UAE">🇦🇪 United Arab Emirates</option>
            <option value="Saudi">🇸🇦 Saudi Arabia (KSA)</option>
            <option value="Qatar">🇶🇦 Qatar</option>
            <option value="Germany">🇩🇪 Germany & EU</option>
            <option value="United States">🇺🇸 United States (H-2B)</option>
            <option value="New Zealand">🇳🇿 New Zealand & Australia</option>
          </select>
        </div>

        <button type="submit" class="search-submit-btn">
          <span>Search Jobs</span>
          <i class="fa-solid fa-arrow-right"></i>
        </button>
      </form>

      <!-- Popular Country Quick Chips -->
      <div class="hero-country-chips" style="display: flex; align-items: center; flex-wrap: wrap; gap: 8px; margin-top: 24px;">
        <span style="font-size: 0.85rem; color: #475569; font-weight: 700; margin-right: 4px; white-space: nowrap;">Top Destinations:</span>
        <button type="button" class="hero-country-chip" onclick="filterByCountryPill('UAE', this)" style="display: inline-flex !important; align-items: center !important; gap: 8px !important; padding: 6px 14px !important; border-radius: 9999px !important; border: 1.5px solid #CBD5E1 !important; background: #FFFFFF !important; cursor: pointer !important; flex-shrink: 0 !important;">
          <img src="/images/flags/ae.svg" alt="UAE" class="flag-img" width="22" height="15" style="width: 22px !important; height: 15px !important; min-width: 22px !important; max-width: 22px !important; object-fit: cover !important; border-radius: 2px !important; flex-shrink: 0 !important; display: inline-block !important;" />
          <span style="font-size: 0.84rem !important; font-weight: 700 !important; color: #0B192C !important; white-space: nowrap !important;">UAE</span>
        </button>
        <button type="button" class="hero-country-chip" onclick="filterByCountryPill('Germany', this)" style="display: inline-flex !important; align-items: center !important; gap: 8px !important; padding: 6px 14px !important; border-radius: 9999px !important; border: 1.5px solid #CBD5E1 !important; background: #FFFFFF !important; cursor: pointer !important; flex-shrink: 0 !important;">
          <img src="/images/flags/de.svg" alt="Germany" class="flag-img" width="22" height="15" style="width: 22px !important; height: 15px !important; min-width: 22px !important; max-width: 22px !important; object-fit: cover !important; border-radius: 2px !important; flex-shrink: 0 !important; display: inline-block !important;" />
          <span style="font-size: 0.84rem !important; font-weight: 700 !important; color: #0B192C !important; white-space: nowrap !important;">Germany</span>
        </button>
        <button type="button" class="hero-country-chip" onclick="filterByCountryPill('Qatar', this)" style="display: inline-flex !important; align-items: center !important; gap: 8px !important; padding: 6px 14px !important; border-radius: 9999px !important; border: 1.5px solid #CBD5E1 !important; background: #FFFFFF !important; cursor: pointer !important; flex-shrink: 0 !important;">
          <img src="/images/flags/qa.svg" alt="Qatar" class="flag-img" width="22" height="15" style="width: 22px !important; height: 15px !important; min-width: 22px !important; max-width: 22px !important; object-fit: cover !important; border-radius: 2px !important; flex-shrink: 0 !important; display: inline-block !important;" />
          <span style="font-size: 0.84rem !important; font-weight: 700 !important; color: #0B192C !important; white-space: nowrap !important;">Qatar</span>
        </button>
        <button type="button" class="hero-country-chip" onclick="filterByCountryPill('Saudi', this)" style="display: inline-flex !important; align-items: center !important; gap: 8px !important; padding: 6px 14px !important; border-radius: 9999px !important; border: 1.5px solid #CBD5E1 !important; background: #FFFFFF !important; cursor: pointer !important; flex-shrink: 0 !important;">
          <img src="/images/flags/sa.svg" alt="Saudi Arabia" class="flag-img" width="22" height="15" style="width: 22px !important; height: 15px !important; min-width: 22px !important; max-width: 22px !important; object-fit: cover !important; border-radius: 2px !important; flex-shrink: 0 !important; display: inline-block !important;" />
          <span style="font-size: 0.84rem !important; font-weight: 700 !important; color: #0B192C !important; white-space: nowrap !important;">Saudi Arabia</span>
        </button>
        <button type="button" class="hero-country-chip" onclick="filterByCountryPill('United States', this)" style="display: inline-flex !important; align-items: center !important; gap: 8px !important; padding: 6px 14px !important; border-radius: 9999px !important; border: 1.5px solid #CBD5E1 !important; background: #FFFFFF !important; cursor: pointer !important; flex-shrink: 0 !important;">
          <img src="/images/flags/us.svg" alt="USA" class="flag-img" width="22" height="15" style="width: 22px !important; height: 15px !important; min-width: 22px !important; max-width: 22px !important; object-fit: cover !important; border-radius: 2px !important; flex-shrink: 0 !important; display: inline-block !important;" />
          <span style="font-size: 0.84rem !important; font-weight: 700 !important; color: #0B192C !important; white-space: nowrap !important;">USA</span>
        </button>
        <button type="button" class="hero-country-chip" onclick="filterByCountryPill('New Zealand', this)" style="display: inline-flex !important; align-items: center !important; gap: 8px !important; padding: 6px 14px !important; border-radius: 9999px !important; border: 1.5px solid #CBD5E1 !important; background: #FFFFFF !important; cursor: pointer !important; flex-shrink: 0 !important;">
          <img src="/images/flags/nz.svg" alt="New Zealand" class="flag-img" width="22" height="15" style="width: 22px !important; height: 15px !important; min-width: 22px !important; max-width: 22px !important; object-fit: cover !important; border-radius: 2px !important; flex-shrink: 0 !important; display: inline-block !important;" />
          <span style="font-size: 0.84rem !important; font-weight: 700 !important; color: #0B192C !important; white-space: nowrap !important;">New Zealand</span>
        </button>
      </div>

      <!-- Visual Trust Badges Strip (Compliant & Honest) -->
      <div class="trust-badges-strip">
        <div class="trust-badge-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>Direct Company Demand</span>
        </div>
        <div class="trust-badge-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>Official Visa Guidance</span>
        </div>
        <div class="trust-badge-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>Verified Direct Employers</span>
        </div>
        <div class="trust-badge-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>Transparent Terms</span>
        </div>
        <div class="trust-badge-item">
          <i class="fa-solid fa-circle-check"></i>
          <span>Anti-Fraud Protection</span>
        </div>
      </div>

    </div>
  </section>

  <!-- ==========================================================================
       2. LIVE JOBS DASHBOARD SECTION (TRUST METRICS)
       ========================================================================== -->
  <section class="live-pulse-section">
    <div class="container">
      <div class="live-pulse-grid">
        
        <!-- Metric 1: Active Jobs -->
        <div class="live-pulse-card">
          <div class="pulse-card-header">
            <div class="pulse-card-icon pulse-icon-gold">
              <i class="fa-solid fa-briefcase"></i>
            </div>
            <span class="pulse-status-badge">
              <span class="pulse-dot-live"></span>
              <span>Live Database</span>
            </span>
          </div>
          <div class="pulse-card-value"><%= (typeof stats !== 'undefined' && stats.totalActive) ? stats.totalActive : jobs.length %></div>
          <p class="pulse-card-label">Active Verified Overseas Jobs</p>
        </div>

        <!-- Metric 2: Candidates Assisted -->
        <div class="live-pulse-card">
          <div class="pulse-card-header">
            <div class="pulse-card-icon pulse-icon-blue">
              <i class="fa-solid fa-user-check"></i>
            </div>
            <span class="pulse-status-badge" style="color: #93C5FD;">
              Verified Support
            </span>
          </div>
          <div class="pulse-card-value">12,500+</div>
          <p class="pulse-card-label">Candidates Guided</p>
        </div>

        <!-- Metric 3: Countries -->
        <div class="live-pulse-card">
          <div class="pulse-card-header">
            <div class="pulse-card-icon pulse-icon-purple">
              <i class="fa-solid fa-earth-americas"></i>
            </div>
            <span class="pulse-status-badge" style="color: #E9D5FF;">
              Global Network
            </span>
          </div>
          <div class="pulse-card-value"><%= (typeof stats !== 'undefined' && stats.countriesCount) ? stats.countriesCount : 6 %>+</div>
          <p class="pulse-card-label">Overseas Destination Countries</p>
        </div>

        <!-- Metric 4: Direct Company Contracts -->
        <div class="live-pulse-card">
          <div class="pulse-card-header">
            <div class="pulse-card-icon pulse-icon-green">
              <i class="fa-solid fa-file-contract"></i>
            </div>
            <span class="pulse-status-badge" style="color: #6EE7B7;">
              Authentic Quotas
            </span>
          </div>
          <div class="pulse-card-value">100%</div>
          <p class="pulse-card-label">Direct Company Contracts</p>
        </div>

      </div>
    </div>
  </section>

  <!-- ==========================================================================
       3. POPULAR CATEGORIES (INTERACTIVE QUICK FILTERS)
       ========================================================================== -->
  <section class="popular-categories-section">
    <div class="container">
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px;">
        <div>
          <div class="section-badge" style="background: rgba(212, 175, 55, 0.12); border-color: var(--border-gold); color: var(--gold-300);">
            <i class="fa-solid fa-layer-group"></i>
            <span>Browse By Trade</span>
          </div>
          <h2 class="section-title" style="margin-bottom: 0;">Popular <span class="gold-gradient-text">Job Categories</span></h2>
        </div>
        <button type="button" class="btn btn-secondary" style="font-size: 0.88rem; padding: 8px 16px;" onclick="filterJobsLive('', '', '')">
          <i class="fa-solid fa-rotate-left"></i>
          <span>Reset All Filters</span>
        </button>
      </div>

      <div class="popular-categories-grid">
        
        <!-- Category 1: Construction -->
        <div class="category-chip-card" onclick="filterByCategoryPill('Construction', this)">
          <div class="category-chip-icon"><i class="fa-solid fa-trowel-bricks"></i></div>
          <h3 class="category-chip-title">Construction</h3>
          <span class="category-chip-count">Helpers, Riggers, Steel</span>
        </div>

        <!-- Category 2: Drivers -->
        <div class="category-chip-card" onclick="filterByCategoryPill('Logistics', this)">
          <div class="category-chip-icon"><i class="fa-solid fa-truck-fast"></i></div>
          <h3 class="category-chip-title">Drivers</h3>
          <span class="category-chip-count">Heavy, Trailer & Tanker</span>
        </div>

        <!-- Category 3: Warehouse -->
        <div class="category-chip-card" onclick="filterByCategoryPill('Warehouse', this)">
          <div class="category-chip-icon"><i class="fa-solid fa-warehouse"></i></div>
          <h3 class="category-chip-title">Warehouse</h3>
          <span class="category-chip-count">Loaders, Logistics, Forklift</span>
        </div>

        <!-- Category 4: Hospitality -->
        <div class="category-chip-card" onclick="filterByCategoryPill('Hospitality', this)">
          <div class="category-chip-icon"><i class="fa-solid fa-utensils"></i></div>
          <h3 class="category-chip-title">Hospitality</h3>
          <span class="category-chip-count">Chefs, Resort Crew, Waiters</span>
        </div>

        <!-- Category 5: Oil & Gas -->
        <div class="category-chip-card" onclick="filterByCategoryPill('Oil & Gas', this)">
          <div class="category-chip-icon"><i class="fa-solid fa-gas-pump"></i></div>
          <h3 class="category-chip-title">Oil & Gas</h3>
          <span class="category-chip-count">Refinery, Valve, Piping</span>
        </div>

        <!-- Category 6: Manufacturing -->
        <div class="category-chip-card" onclick="filterByCategoryPill('Manufacturing', this)">
          <div class="category-chip-icon"><i class="fa-solid fa-industry"></i></div>
          <h3 class="category-chip-title">Manufacturing</h3>
          <span class="category-chip-count">6G Welders, Mechanics, CNC</span>
        </div>

      </div>
    </div>
  </section>

  <!-- ==========================================================================
       4. LIVE OPENINGS (JOB CARDS ARE THE HERO)
       ========================================================================== -->
  <section id="live-openings" class="section-spacing" style="padding-top: 20px;">
    <div class="container">
      
      <div style="display: flex; justify-content: space-between; align-items: flex-end; flex-wrap: wrap; gap: 16px; margin-bottom: 28px;">
        <div>
          <div class="section-badge" style="background: rgba(16, 185, 129, 0.12); border-color: rgba(16, 185, 129, 0.35); color: #34D399;">
            <i class="fa-solid fa-fire"></i>
            <span>Featured International Openings</span>
          </div>
          <h2 class="section-title">Latest Verified <span class="gold-gradient-text">Job Vacancies</span></h2>
          <p class="section-subtitle" style="margin: 0;">
            Apply directly with our 5-step quick candidate intake. Opens immediately with the recruiter on WhatsApp.
          </p>
        </div>

        <div style="display: flex; align-items: center; gap: 14px;">
          <span id="liveJobsCountLabel" style="font-family: var(--font-mono); font-size: 0.9rem; color: var(--gold-light); font-weight: 700;">
            <%= jobs.length %> openings available
          </span>
          <a href="/jobs" class="btn btn-secondary" style="padding: 10px 18px; font-size: 0.9rem;">
            <span>View All Jobs &rarr;</span>
          </a>
        </div>
      </div>

      <!-- Hero Job Cards Grid -->
      <div class="job-cards-hero-grid" id="liveJobsGrid">
        <% if (jobs && jobs.length > 0) { %>
          <% jobs.forEach(job => { %>
            <div class="job-card-premium job-filter-target" 
                 data-title="<%= job.title %>" 
                 data-country="<%= job.country %>" 
                 data-category="<%= job.category %>">
              
              <!-- Card Photo Header -->
              <a href="/jobs/<%= job.job_code || job.id %>" class="card-photo-header" style="display: block; text-decoration: none;">
                <img src="<%= job.image || '/images/corporate_hero_bg.jpg' %>" alt="<%= job.title %> in <%= job.country %>" loading="lazy" />
                <div class="card-photo-overlay">
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span class="card-country-flag-badge">
                      <span><%= job.flag || '🌐' %></span>
                      <span><%= job.country.split('(')[0].trim() %></span>
                    </span>
                    <span class="card-fee-pill standard"><i class="fa-solid fa-building"></i> Direct Company Demand</span>
                  </div>
                  <div>
                    <span style="font-family: var(--font-mono); font-size: 0.72rem; color: var(--gold-primary); background: rgba(0,0,0,0.65); padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(212,175,55,0.3);">
                      Ref: <%= job.job_code %>
                    </span>
                  </div>
                </div>
              </a>

              <!-- Card Content -->
              <div class="job-card-content">
                <div>
                  <a href="/jobs/<%= job.job_code || job.id %>" style="text-decoration: none; color: inherit;">
                    <h3 style="font-size: 1.25rem; font-weight: 700; margin: 0 0 6px 0; line-height: 1.35; transition: color 0.2s ease;">
                      <%= job.title %>
                    </h3>
                  </a>
                  <div style="font-size: 0.82rem; color: var(--text-muted); display: flex; align-items: center; gap: 6px;">
                    <i class="fa-solid fa-wrench" style="color: var(--royal-blue);"></i>
                    <span><%= job.category %></span>
                  </div>

                  <!-- Salary Badge -->
                  <div class="salary-badge-glow">
                    <span><%= job.salary_inr %></span>
                    <% if (job.salary_foreign) { %>
                      <span style="font-size: 0.82rem; color: var(--text-muted); font-weight: 600; font-family: var(--font-body); margin-left: 6px;">
                        (<%= job.salary_foreign %>)
                      </span>
                    <% } %>
                  </div>

                  <!-- Key Amenities / Perks -->
                  <div style="display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 18px;">
                    <% (job.perks || []).slice(0, 3).forEach(perk => { %>
                      <span class="amenity-chip-item">
                        <i class="fa-solid fa-check" style="color: #10B981; margin-right: 4px;"></i> <%= perk %>
                      </span>
                    <% }); %>
                  </div>
                </div>

                <!-- Card Action Row: Save, Share, Details, Apply Now -->
                <div class="job-card-action-bar">
                  <button type="button" class="card-mini-btn" onclick="saveJobBookmark('<%= job.job_code %>', this)" title="Save Job" aria-label="Bookmark Job">
                    <i class="fa-regular fa-bookmark"></i>
                  </button>
                  <button type="button" class="card-mini-btn" onclick="shareJobOpening('<%= job.job_code %>', '<%= job.title %>')" title="Share Job" aria-label="Share Job">
                    <i class="fa-solid fa-share-nodes"></i>
                  </button>
                  <a href="/jobs/<%= job.job_code || job.id %>" class="btn btn-secondary card-details-btn">
                    <span>Details</span>
                  </a>
                  <button type="button" class="btn btn-gold card-apply-btn" 
                          data-job-code="<%= job.job_code %>" 
                          data-job-title="<%= job.title %>" 
                          data-job-country="<%= job.country %>" 
                          data-job-salary="<%= job.salary_foreign || job.salary_inr %>" 
                          data-job-category="<%= job.category %>" 
                          onclick="triggerJobApply(this)">
                    <i class="fa-brands fa-whatsapp"></i>
                    <span>Apply Now</span>
                  </button>
                </div>
              </div>

            </div>
          <% }); %>
        <% } else { %>
          <div class="empty-jobs-card" style="grid-column: 1 / -1; text-align: center; padding: 56px 24px; border-radius: 20px; background: #FFFFFF; border: 1.5px solid #E2E8F0; box-shadow: 0 4px 20px -2px rgba(11, 25, 44, 0.06);">
            <div style="width: 64px; height: 64px; border-radius: 50%; background: #EFF6FF; border: 1px solid #BFDBFE; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 18px;">
              <i class="fa-solid fa-briefcase" style="font-size: 1.8rem; color: #1D4ED8;"></i>
            </div>
            <h3 style="font-size: 1.4rem; color: #0B192C; margin-bottom: 8px; font-weight: 800;">No Active Overseas Openings Right Now</h3>
            <p style="color: #64748B; max-width: 540px; margin: 0 auto 24px auto; font-size: 0.95rem; line-height: 1.65;">
              New verified international vacancies are published directly by our HR recruitment operations desk. You can submit your candidate profile to get instantly matched once suitable employer quotas open.
            </p>
            <a href="#lead-funnel" class="btn btn-gold" style="display: inline-flex; padding: 12px 24px; font-weight: 700;">
              <span>Submit Candidate Profile</span>
              <i class="fa-solid fa-arrow-right"></i>
            </a>
          </div>
        <% } %>
      </div>

      <!-- No Results Feedback State (Shown when search/filter returns 0 items) -->
      <div id="liveJobsNoResults" style="display: none; text-align: center; padding: 50px 24px; margin-top: 24px; border-radius: 20px; background: #FFFFFF; border: 1.5px solid #E2E8F0; box-shadow: 0 4px 20px -2px rgba(11, 25, 44, 0.06);">
        <div style="width: 56px; height: 56px; border-radius: 50%; background: #FEF3C7; border: 1px solid #FDE68A; display: inline-flex; align-items: center; justify-content: center; margin-bottom: 16px;">
          <i class="fa-solid fa-magnifying-glass" style="font-size: 1.5rem; color: #B45309;"></i>
        </div>
        <h3 style="font-size: 1.35rem; color: #0B192C; margin-bottom: 8px; font-weight: 800;">No Openings Match Your Filter</h3>
        <p style="color: #64748B; max-width: 480px; margin: 0 auto 20px auto; font-size: 0.95rem;">
          Try adjusting your search terms or clearing your country and trade filters to see all available international vacancies.
        </p>
        <button type="button" class="btn btn-secondary" onclick="filterJobsLive('', '', '')" style="padding: 10px 20px; font-weight: 700;">
          <i class="fa-solid fa-rotate-left"></i>
          <span>Show All Openings</span>
        </button>
      </div>

    </div>
  </section>

  <!-- ==========================================================================
       5. INTERACTIVE WORLD MAP & REGIONAL HUB (REPLACING 3D GLOBE)
       ========================================================================== -->
  <section id="world-map-hub" class="regional-hub-section">
    <div class="container">
      
      <div class="section-header" style="text-align: center; margin-bottom: 30px;">
        <div class="section-badge" style="background: rgba(56, 189, 248, 0.12); border-color: rgba(56, 189, 248, 0.35); color: #38BDF8;">
          <i class="fa-solid fa-map-location-dot"></i>
          <span>Global Deployment Hubs</span>
        </div>
        <h2 class="section-title">Explore Jobs by <span class="gold-gradient-text">World Region</span></h2>
        <p class="section-subtitle" style="max-width: 680px; margin: 0 auto;">
          Direct recruitment programs across four dedicated overseas hubs. Select your target region to filter live openings.
        </p>
      </div>

      <div class="regional-hub-layout">
        
        <% 
          const meCount = (typeof stats !== 'undefined' && stats.regions && typeof stats.regions.middleEast === 'number') ? stats.regions.middleEast : 0;
