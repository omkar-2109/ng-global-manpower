              <i class="fa-solid fa-truck-fast trade-card-icon"></i>
              <span class="trade-card-name">Logistics</span>
              <span class="trade-card-badge">Express Processing</span>
            </div>
            <div class="trade-card-btn" onclick="selectTrade(this, 'Manufacturing & Industrial')">
              <i class="fa-solid fa-industry trade-card-icon"></i>
              <span class="trade-card-name">Manufacturing</span>
              <span class="trade-card-badge">Active Quotas</span>
            </div>
            <div class="trade-card-btn" onclick="selectTrade(this, 'Electrical, Plumbing & MEP')">
              <i class="fa-solid fa-plug-circle-bolt trade-card-icon"></i>
              <span class="trade-card-name">MEP / Technical</span>
              <span class="trade-card-badge">High Salary</span>
            </div>
            <div class="trade-card-btn" onclick="selectTrade(this, 'Other Skilled Trades')">
              <i class="fa-solid fa-screwdriver-wrench trade-card-icon"></i>
              <span class="trade-card-name">Other Trades</span>
              <span class="trade-card-badge">Open Categories</span>
            </div>
          </div>
          <div class="funnel-nav-actions" style="justify-content: flex-end;">
            <button type="button" class="btn btn-gold" onclick="goToStep(2)">
              <span>Next: Select Destination</span>
              <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>
        </div>

        <!-- STEP 2 -->
        <div id="panelStep2" class="funnel-step-panel">
          <h3 class="panel-question-title">Step 2: Where do you want to work?</h3>
          <p class="panel-question-desc">Choose your preferred international region for visa sponsorship.</p>
          <div class="dest-options-grid">
            <div class="dest-card-btn selected" onclick="selectDest(this, 'Gulf Countries (UAE, Saudi, Qatar)')">
              <div class="dest-flag-icon">⚡</div>
              <div class="dest-info">
                <h4>Gulf Countries</h4>
                <p>UAE, Saudi Arabia, Qatar, Kuwait, Oman</p>
                <span class="dest-badge-time time-badge-fast"><i class="fa-solid fa-bolt"></i> 1 to 15 Days Fast-Track</span>
              </div>
            </div>
            <div class="dest-card-btn" onclick="selectDest(this, 'Europe (Germany, Poland, UK)')">
              <div class="dest-flag-icon">🇪🇺</div>
              <div class="dest-info">
                <h4>Europe</h4>
                <p>Germany, Poland, Czechia, Romania</p>
                <span class="dest-badge-time time-badge-std"><i class="fa-solid fa-clock"></i> ~3 Months Processing</span>
              </div>
            </div>
            <div class="dest-card-btn" onclick="selectDest(this, 'United States (H-2B / Industry)')">
              <div class="dest-flag-icon">🇺🇸</div>
              <div class="dest-info">
                <h4>United States</h4>
                <p>H-2B Seasonal, Construction & Logistics</p>
                <span class="dest-badge-time time-badge-std"><i class="fa-solid fa-clock"></i> ~3 Months Processing</span>
              </div>
            </div>
            <div class="dest-card-btn" onclick="selectDest(this, 'New Zealand & Australia')">
              <div class="dest-flag-icon">🇳🇿</div>
              <div class="dest-info">
                <h4>New Zealand / Australia</h4>
                <p>Accredited Employer Work Visa Programs</p>
                <span class="dest-badge-time time-badge-std"><i class="fa-solid fa-clock"></i> ~3 Months Processing</span>
              </div>
            </div>
          </div>
          <div class="funnel-nav-actions">
            <button type="button" class="btn btn-secondary" onclick="goToStep(1)">
              <i class="fa-solid fa-arrow-left"></i> <span>Back</span>
            </button>
            <button type="button" class="btn btn-gold" onclick="goToStep(3)">
              <span>Next: Contact Details</span> <i class="fa-solid fa-arrow-right"></i>
            </button>
          </div>
        </div>

        <!-- STEP 3 -->
        <div id="panelStep3" class="funnel-step-panel">
          <h3 class="panel-question-title">Step 3: Your Contact Details</h3>
          <p class="panel-question-desc">We will verify your profile and connect you directly to our official career executive on WhatsApp.</p>
          <form id="leadCaptureForm" onsubmit="handleFormSubmission(event)">
            <div class="contact-form-grid">
              <div class="form-group">
                <label class="form-label" for="candidateName">Full Name *</label>
                <input type="text" id="candidateName" class="form-input-box" placeholder="e.g. Ramesh Patel" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="candidatePhone">WhatsApp Phone Number *</label>
                <input type="tel" id="candidatePhone" class="form-input-box" placeholder="e.g. +91 98765 43210" required />
              </div>
              <div class="form-group">
                <label class="form-label" for="candidateExp">Years of Experience</label>
                <select id="candidateExp" class="form-input-box">
                  <option value="1 to 2 Years">1 to 2 Years (Junior)</option>
                  <option value="3 to 5 Years" selected>3 to 5 Years (Experienced)</option>
                  <option value="5+ Years GCC / Overseas">5+ Years (Overseas Returned / Senior)</option>
                  <option value="Fresher with Certificate">Fresher with Trade ITI / Diploma</option>
                </select>
              </div>
              <div class="form-group">
                <label class="form-label" for="candidateCity">Your Current City / State</label>
                <input type="text" id="candidateCity" class="form-input-box" placeholder="e.g. Mumbai, Maharashtra" />
              </div>
            </div>
            <div class="funnel-nav-actions">
              <button type="button" class="btn btn-secondary" onclick="goToStep(2)">
                <i class="fa-solid fa-arrow-left"></i> <span>Back</span>
              </button>
              <button type="submit" class="btn btn-whatsapp" style="font-size: 1.02rem; padding: 16px 28px; width: 100%;">
                <i class="fa-brands fa-whatsapp" style="font-size: 1.3rem;"></i>
                <span>Check Eligibility & Connect on WhatsApp</span>
              </button>
            </div>
          </form>
        </div>

      </div>
    </div>
  </section>

  <!-- ==========================================================================
       10. ANTI-FRAUD ADVISORY BANNER
       ========================================================================== -->
  <section id="fraud-advisory" class="fraud-banner-section">
    <div class="container">
      <div class="fraud-banner-content">
        <div class="fraud-icon-shield">
          <i class="fa-solid fa-triangle-exclamation"></i>
        </div>
        <div class="fraud-text-box">
          <h3>Beware of Fraudulent Recruitment Agents Demanding Upfront Cash Deposits</h3>
          <p>
            NG Global Manpower Services maintains transparent, regulated service charges, with selected overseas project quotas 100% sponsored by employers. Official visa application, consular biometrics, and GAMCA medical fees are payable directly to government portals and authorized medical clinics—never into personal bank accounts of unverified middlemen. Report any suspicious agent immediately to our official helpline.
          </p>
        </div>
        <div>
          <a href="https://wa.me/918080025670?text=Hello%20NG%20Global,%20I%20want%20to%20verify%20a%20recruitment%20agent%20claim." target="_blank" class="btn btn-secondary">
            <i class="fa-solid fa-shield"></i>
            <span>Verify Official Agent</span>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- ==========================================================================
       11. FAQ ACCORDION
       ========================================================================== -->
  <section id="faq" class="section-spacing">
    <div class="container">
      <div class="section-header">
        <div class="section-badge">
          <i class="fa-solid fa-circle-question"></i>
          <span>Common Queries</span>
        </div>
        <h2 class="section-title">Frequently Asked <span class="gold-gradient-text">Questions</span></h2>
        <p class="section-subtitle">
          Everything you need to know about our candidate coordination, employer allocations, and official embassy processing.
        </p>
      </div>

      <div class="faq-grid">
        <div class="faq-item active">
          <div class="faq-question" onclick="toggleFaq(this)">
            <span>How are NG Global agency service charges structured?</span>
            <i class="fa-solid fa-chevron-down faq-icon-arrow"></i>
          </div>
          <div class="faq-answer">
            NG Global operates with transparent, government-compliant service charges. We do not demand unaccounted advance deposits. Once you register, our career executive coordinates 1-on-1 on WhatsApp to evaluate your trade credentials and explain the exact milestone-based fee structure before you commit. In addition, we regularly offer 100% Company-Sponsored Quotas where overseas employers cover all agency expenses for selected trades.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question" onclick="toggleFaq(this)">
            <span>Why are some international jobs completely free with zero service charges?</span>
            <i class="fa-solid fa-chevron-down faq-icon-arrow"></i>
          </div>
          <div class="faq-answer">
            A select few international positions have zero service charges because overseas principal companies fully sponsor the recruitment and hiring costs directly to us for those specific project quotas. In these specific cases, candidates do not pay any service charges.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question" onclick="toggleFaq(this)">
            <span>How do official visa application and processing payments work?</span>
            <i class="fa-solid fa-chevron-down faq-icon-arrow"></i>
          </div>
          <div class="faq-answer">
            Candidates pay all official visa application fees, GAMCA medical examinations, and consular biometric processing charges directly to the relevant foreign embassies, government portals, or authorized diagnostic clinics. You never pay government visa fees to personal accounts of unverified agents.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question" onclick="toggleFaq(this)">
            <span>Why is the Gulf process so fast (1 to 15 days) compared to Western countries?</span>
            <i class="fa-solid fa-chevron-down faq-icon-arrow"></i>
          </div>
          <div class="faq-answer">
            Gulf nations use streamlined electronic e-Visa portals directly connected to employer corporate block visas. In contrast, European countries, the USA, and New Zealand require formal labor market certifications, consular interviews, and biometric physical passport submissions, which take approximately 90 days.
          </div>
        </div>

        <div class="faq-item">
          <div class="faq-question" onclick="toggleFaq(this)">
            <span>Are food, accommodation, and transport provided by the employer?</span>
            <i class="fa-solid fa-chevron-down faq-icon-arrow"></i>
          </div>
          <div class="faq-answer">
            Yes! All contracts secured through NG Global include free bachelor accommodation, duty transportation, medical health insurance, and either free meals or a generous monthly food allowance on top of your base salary.
          </div>
        </div>
      </div>
    </div>
  </section>

