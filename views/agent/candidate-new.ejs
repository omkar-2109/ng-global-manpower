<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof title !== 'undefined' ? title : 'New Candidate Intake | NG Global' %></title>
  <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>📄</text></svg>" />

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />

  <!-- FontAwesome 6 -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />

  <!-- Admin Stylesheet -->
  <link rel="stylesheet" href="/css/admin.css" />
</head>
<body class="admin-body">

  <!-- Agent Navigation Bar -->
  <header class="admin-navbar">
    <a href="/agent/dashboard" class="admin-nav-brand">
      <img src="/brand/4_Brand_Emblem_Only/ng-emblem-transparent-1024px.png" alt="NG Global Emblem" />
      <span>NG GLOBAL <small style="font-weight: 500; color: var(--admin-gold); font-size: 0.8rem; margin-left: 6px;">AGENT PORTAL</small></span>
    </a>

    <ul class="admin-nav-links">
      <li>
        <a href="/agent/dashboard" class="admin-nav-link">
          <i class="fa-solid fa-gauge-high"></i>
          <span>My Candidates</span>
        </a>
      </li>
      <li>
        <a href="/agent/candidates/new" class="admin-nav-link active">
          <i class="fa-solid fa-user-plus"></i>
          <span>New Intake</span>
        </a>
      </li>
      <li>
        <a href="/agency/<%= agent.username %>" target="_blank" class="admin-nav-link">
          <i class="fa-solid fa-globe"></i>
          <span>My Public Landing URL</span>
        </a>
      </li>
    </ul>

    <div class="admin-user-pill">
      <span class="user-badge" style="background: rgba(212, 175, 55, 0.15); color: var(--admin-gold); border: 1px solid rgba(212, 175, 55, 0.3);">
        <i class="fa-solid fa-certificate"></i> <%= agent.agency_name %>
      </span>
      <a href="/agent/logout" class="btn-admin btn-admin-secondary" style="padding: 6px 12px; font-size: 0.8rem;">
        <i class="fa-solid fa-arrow-right-from-bracket"></i>
        <span>Sign Out</span>
      </a>
    </div>
  </header>

  <main class="admin-container">

    <div class="admin-page-header">
      <div class="admin-page-title">
        <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 6px;">
          <a href="/agent/dashboard" style="color: var(--admin-text-muted); text-decoration: none; font-size: 0.9rem;">
            &larr; Back to Candidates
          </a>
        </div>
        <h1>Candidate Intake & Document Dossier Compilation</h1>
        <p>Enter full candidate details and upload documents. All files will be automatically compressed, named after the candidate, and merged into a single master PDF.</p>
      </div>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="admin-alert admin-alert-error" style="max-width: 900px; margin-bottom: 20px;">
        <i class="fa-solid fa-triangle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <div style="max-width: 900px;">
      <div class="card-panel">
        
        <form action="/agent/candidates" method="POST" enctype="multipart/form-data">
          
          <!-- Section 1: Candidate Personal Info -->
          <h3 style="color: var(--admin-gold); font-size: 1.1rem; margin-top: 0; margin-bottom: 18px; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-user"></i> 1. Candidate Personal Information
          </h3>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group">
              <label class="form-label" for="full_name">Candidate Full Name (As per Passport) *</label>
              <input type="text" id="full_name" name="full_name" class="form-control" placeholder="e.g. Rajesh Kumar Verma" required />
            </div>

            <div class="form-group">
              <label class="form-label" for="phone">Primary Contact Phone *</label>
              <input type="tel" id="phone" name="phone" class="form-control" placeholder="e.g. +91 98234 11223" required />
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
            <div class="form-group">
              <label class="form-label" for="whatsapp">WhatsApp Number</label>
              <input type="tel" id="whatsapp" name="whatsapp" class="form-control" placeholder="e.g. +91 98234 11223" />
            </div>

            <div class="form-group">
              <label class="form-label" for="email">Candidate Email Address</label>
              <input type="email" id="email" name="email" class="form-control" placeholder="candidate@example.com" />
            </div>

            <div class="form-group">
              <label class="form-label" for="dob">Date of Birth</label>
              <input type="date" id="dob" name="dob" class="form-control" style="color-scheme: dark;" />
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
            <div class="form-group">
              <label class="form-label" for="city">Current City / District</label>
              <input type="text" id="city" name="city" class="form-control" placeholder="e.g. Gorakhpur" />
            </div>

            <div class="form-group">
              <label class="form-label" for="state">State / Province</label>
              <input type="text" id="state" name="state" class="form-control" placeholder="e.g. Uttar Pradesh" />
            </div>

            <div class="form-group">
              <label class="form-label" for="nationality">Nationality</label>
              <input type="text" id="nationality" name="nationality" class="form-control" value="Indian" />
            </div>
          </div>

          <hr style="border: 0; border-top: 1px solid var(--admin-border); margin: 28px 0;" />

          <!-- Section 2: Passport & Deployment Trade -->
          <h3 style="color: var(--admin-gold); font-size: 1.1rem; margin-bottom: 18px; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-passport"></i> 2. Trade & Passport Information
          </h3>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group">
              <label class="form-label" for="trade">Trade / Specialty Position *</label>
              <input type="text" id="trade" name="trade" class="form-control" placeholder="e.g. 6G TIG Welder / Heavy Driver" required />
            </div>

            <div class="form-group">
              <label class="form-label" for="destination">Target Destination Region</label>
              <select id="destination" name="destination" class="form-control" style="background: #081636;">
                <option value="Singapore (Work Permit / E-Pass / S-Pass)">Singapore 🇸🇬 (Work Permit / E-Pass)</option>
                <option value="Saudi Arabia">Saudi Arabia (KSA)</option>
                <option value="United Arab Emirates (Dubai/Abu Dhabi)">UAE (Dubai / Abu Dhabi)</option>
                <option value="Qatar">Qatar</option>
                <option value="Kuwait">Kuwait</option>
                <option value="Europe (Germany, Poland, Romania)">Europe (Germany, Poland, Romania)</option>
                <option value="Any Gulf / GCC Country">Any GCC Country</option>
              </select>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 20px;">
            <div class="form-group">
              <label class="form-label" for="experience">Total Experience</label>
              <select id="experience" name="experience" class="form-control" style="background: #081636;">
                <option value="Fresher (No Overseas)">Fresher (India / Domestic Exp)</option>
                <option value="1 to 2 Years">1 to 2 Years</option>
                <option value="3 to 5 Years">3 to 5 Years</option>
                <option value="5+ Years GCC Return">5+ Years GCC / Overseas Return</option>
              </select>
            </div>

            <div class="form-group">
              <label class="form-label" for="passport_no">Passport Number</label>
              <input type="text" id="passport_no" name="passport_no" class="form-control" placeholder="e.g. Z1234567" style="text-transform: uppercase;" />
            </div>

            <div class="form-group">
              <label class="form-label" for="passport_expiry">Passport Expiry Date</label>
              <input type="date" id="passport_expiry" name="passport_expiry" class="form-control" style="color-scheme: dark;" />
            </div>
          </div>

          <div class="form-group">
            <label class="form-label" for="gamca_status">GAMCA Medical Status</label>
            <select id="gamca_status" name="gamca_status" class="form-control" style="background: #081636;">
              <option value="Pending">Not Done / Pending GAMCA</option>
              <option value="Appointment Booked">Appointment Booked</option>
              <option value="Passed / Fit">Passed / Medically Fit Certificate Available</option>
            </select>
          </div>

          <hr style="border: 0; border-top: 1px solid var(--admin-border); margin: 28px 0;" />

          <!-- Section 3: Document Uploads & Compression / PDF Merge -->
          <h3 style="color: var(--admin-gold); font-size: 1.1rem; margin-bottom: 8px; display: flex; align-items: center; gap: 8px;">
            <i class="fa-solid fa-file-shield"></i> 3. Document Dossier Uploads (PDF or JPG)
          </h3>
          <p style="color: var(--admin-text-muted); font-size: 0.85rem; margin-bottom: 20px;">
            Upload candidate files in PDF or JPG format. Images will be automatically compressed, files will be renamed after the candidate, and <strong>all documents will be automatically compiled into a single master PDF dossier</strong>.
          </p>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
            <div class="form-group" style="background: rgba(255, 255, 255, 0.03); padding: 14px; border-radius: 8px; border: 1px dashed var(--admin-border);">
              <label class="form-label" for="passport_copy">
                <i class="fa-solid fa-passport" style="color: var(--admin-gold); margin-right: 6px;"></i> Passport Copy (Front & Back)
              </label>
              <input type="file" id="passport_copy" name="passport_copy" class="form-control" accept=".pdf,.jpg,.jpeg,.png" multiple />
              <small style="color: var(--admin-text-muted); font-size: 0.78rem;">PDF, JPG, or PNG (Select up to 2 files)</small>
            </div>

            <div class="form-group" style="background: rgba(255, 255, 255, 0.03); padding: 14px; border-radius: 8px; border: 1px dashed var(--admin-border);">
              <label class="form-label" for="photo">
                <i class="fa-solid fa-camera" style="color: var(--admin-cyan); margin-right: 6px;"></i> White-Background Photo
              </label>
              <input type="file" id="photo" name="photo" class="form-control" accept=".jpg,.jpeg,.png" />
              <small style="color: var(--admin-text-muted); font-size: 0.78rem;">Passport size studio photograph</small>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 10px;">
            <div class="form-group" style="background: rgba(255, 255, 255, 0.03); padding: 14px; border-radius: 8px; border: 1px dashed var(--admin-border);">
              <label class="form-label" for="resume">
                <i class="fa-solid fa-file-lines" style="color: #60a5fa; margin-right: 6px;"></i> Candidate Bio-Data / Resume
              </label>
              <input type="file" id="resume" name="resume" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
              <small style="color: var(--admin-text-muted); font-size: 0.78rem;">PDF or image resume</small>
            </div>

            <div class="form-group" style="background: rgba(255, 255, 255, 0.03); padding: 14px; border-radius: 8px; border: 1px dashed var(--admin-border);">
              <label class="form-label" for="certificates">
                <i class="fa-solid fa-award" style="color: #34d399; margin-right: 6px;"></i> Trade Test / Experience Certificates
              </label>
              <input type="file" id="certificates" name="certificates" class="form-control" accept=".pdf,.jpg,.jpeg,.png" multiple />
              <small style="color: var(--admin-text-muted); font-size: 0.78rem;">Trade certificates, diploma, GCC experience</small>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-top: 10px;">
            <div class="form-group" style="background: rgba(255, 255, 255, 0.03); padding: 14px; border-radius: 8px; border: 1px dashed var(--admin-border);">
              <label class="form-label" for="driving_license">
                <i class="fa-solid fa-id-card" style="color: #f59e0b; margin-right: 6px;"></i> Driving License (Indian or GCC)
              </label>
              <input type="file" id="driving_license" name="driving_license" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
              <small style="color: var(--admin-text-muted); font-size: 0.78rem;">Optional for non-driving trades</small>
            </div>

            <div class="form-group" style="background: rgba(255, 255, 255, 0.03); padding: 14px; border-radius: 8px; border: 1px dashed var(--admin-border);">
              <label class="form-label" for="medical_report">
                <i class="fa-solid fa-file-waveform" style="color: #ec4899; margin-right: 6px;"></i> GAMCA Medical Fitness Report
              </label>
              <input type="file" id="medical_report" name="medical_report" class="form-control" accept=".pdf,.jpg,.jpeg,.png" />
              <small style="color: var(--admin-text-muted); font-size: 0.78rem;">Optional if medical is pending</small>
            </div>
          </div>

          <div class="form-group" style="margin-top: 18px;">
            <label class="form-label" for="notes">Partner Agent Remarks / Interview Notes</label>
            <textarea id="notes" name="notes" rows="3" class="form-control" placeholder="Candidate's current availability, trade test evaluation remarks, salary expectations..."></textarea>
          </div>

          <div style="display: flex; gap: 14px; margin-top: 28px; padding-top: 20px; border-top: 1px solid var(--admin-border);">
            <button type="submit" class="btn-admin btn-admin-primary" style="padding: 12px 28px;">
              <i class="fa-solid fa-file-circle-check"></i>
              <span>Submit Dossier & Compile Master PDF</span>
            </button>

            <a href="/agent/dashboard" class="btn-admin btn-admin-secondary" style="padding: 12px 20px;">
              Cancel
            </a>
          </div>

        </form>

      </div>
    </div>

  </main>

</body>
</html>
