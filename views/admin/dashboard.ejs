<%- include('../partials/admin-header') %>

<main class="admin-container">
  
  <!-- Page Header -->
  <div class="admin-page-header">
    <div class="admin-page-title">
      <h1>Recruitment Command Center</h1>
      <p>Real-time candidate eligibility assessments, application pipelines, and overseas quotas.</p>
    </div>
    <div style="display: flex; gap: 12px;">
      <a href="/admin/leads/export" class="btn-admin btn-admin-secondary">
        <i class="fa-solid fa-file-csv"></i>
        <span>Export All Leads (CSV)</span>
      </a>
      <a href="/admin/jobs/new" class="btn-admin btn-admin-primary">
        <i class="fa-solid fa-plus"></i>
        <span>Add Job Quota</span>
      </a>
    </div>
  </div>

  <% if (unreadNotifications && unreadNotifications.length > 0) { %>
    <!-- High-Priority Admin Alert Feed -->
    <div style="margin-bottom: 24px; display: flex; flex-direction: column; gap: 10px;">
      <% unreadNotifications.forEach(notif => { %>
        <div style="background: <%= notif.priority === 'urgent' ? 'linear-gradient(90deg, rgba(239, 68, 68, 0.2) 0%, rgba(15, 23, 42, 0.95) 100%)' : 'rgba(212, 175, 55, 0.12)' %>; border: 1.5px solid <%= notif.priority === 'urgent' ? '#ef4444' : 'var(--admin-border-gold)' %>; border-radius: 10px; padding: 14px 18px; display: flex; justify-content: space-between; align-items: center; gap: 16px; box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);">
          <div style="display: flex; align-items: center; gap: 14px;">
            <div style="width: 40px; height: 40px; border-radius: 10px; background: <%= notif.priority === 'urgent' ? 'rgba(239, 68, 68, 0.25)' : 'rgba(212, 175, 55, 0.2)' %>; display: flex; align-items: center; justify-content: center; font-size: 1.2rem; color: <%= notif.priority === 'urgent' ? '#ef4444' : 'var(--admin-gold)' %>;">
              <i class="fa-solid <%= notif.priority === 'urgent' ? 'fa-triangle-exclamation' : 'fa-bell' %>"></i>
            </div>
            <div>
              <div style="font-weight: 700; color: #fff; font-size: 0.95rem;">
                <%= notif.title %>
                <% if (notif.priority === 'urgent') { %>
                  <span style="background: #ef4444; color: #fff; font-size: 0.68rem; padding: 2px 6px; border-radius: 4px; margin-left: 8px; font-weight: 700; text-transform: uppercase;">Urgent Backout</span>
                <% } %>
              </div>
              <p style="margin: 3px 0 0 0; color: #cbd5e1; font-size: 0.85rem;">
                <%= notif.message %>
              </p>
            </div>
          </div>

          <div style="display: flex; gap: 10px; align-items: center; flex-shrink: 0;">
            <% if (notif.lead_id) { %>
              <a href="/admin/leads/<%= notif.lead_id %>" class="btn-admin btn-admin-primary" style="padding: 6px 14px; font-size: 0.82rem;">
                <i class="fa-solid fa-eye"></i>
                <span>Open Candidate</span>
              </a>
            <% } %>

            <form action="/admin/notifications/<%= notif.id %>/dismiss" method="POST" style="margin: 0;">
              <button type="submit" class="btn-admin btn-admin-secondary" style="padding: 6px 10px; font-size: 0.82rem;" title="Dismiss alert">
                <i class="fa-solid fa-check"></i>
                <span>Dismiss</span>
              </button>
            </form>
          </div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <!-- KPI Cards Grid -->
  <div class="kpi-grid" style="grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));">
    <div class="kpi-card">
      <div class="kpi-header">
        <span class="kpi-title">Total Applications</span>
        <div class="kpi-icon icon-blue"><i class="fa-solid fa-users"></i></div>
      </div>
      <div class="kpi-value"><%= metrics.total %></div>
      <p style="margin: 8px 0 0 0; font-size: 0.78rem; color: var(--admin-text-muted);">All registered records</p>
    </div>

    <div class="kpi-card" style="border-color: rgba(56, 189, 248, 0.4);">
      <div class="kpi-header">
        <span class="kpi-title">Inquiry Leads (Queries)</span>
        <div class="kpi-icon icon-blue"><i class="fa-solid fa-comments"></i></div>
      </div>
      <div class="kpi-value" style="color: var(--admin-cyan);"><%= metrics.inquiries || 0 %></div>
      <p style="margin: 8px 0 0 0; font-size: 0.78rem; color: var(--admin-text-muted);">Follow-up & Explain Procedure</p>
    </div>

    <div class="kpi-card" style="border-color: rgba(212, 175, 55, 0.4);">
      <div class="kpi-header">
        <span class="kpi-title">Confirmed Candidates</span>
        <div class="kpi-icon icon-gold"><i class="fa-solid fa-badge-check"></i></div>
      </div>
      <div class="kpi-value" style="color: var(--admin-gold);"><%= metrics.confirmed || 0 %></div>
      <p style="margin: 8px 0 0 0; font-size: 0.78rem; color: var(--admin-text-muted);">Ready to Pay & Mobilize</p>
    </div>

    <div class="kpi-card" style="border-color: rgba(16, 185, 129, 0.4);">
      <div class="kpi-header">
        <span class="kpi-title">Master Dossiers PDF</span>
        <div class="kpi-icon icon-emerald"><i class="fa-solid fa-file-shield"></i></div>
      </div>
      <div class="kpi-value" style="color: var(--admin-emerald);"><%= metrics.dossiersReady || 0 %></div>
      <p style="margin: 8px 0 0 0; font-size: 0.78rem; color: var(--admin-text-muted);">Compiled Embassy Packages</p>
    </div>

    <div class="kpi-card">
      <div class="kpi-header">
        <span class="kpi-title">In-Progress / Placed</span>
        <div class="kpi-icon icon-gold"><i class="fa-solid fa-plane-departure"></i></div>
      </div>
      <div class="kpi-value" style="color: #C084FC;"><%= (metrics.inProgress || 0) + (metrics.placed || 0) %></div>
      <p style="margin: 8px 0 0 0; font-size: 0.78rem; color: var(--admin-text-muted);"><%= metrics.placed || 0 %> Mobilized Overseas</p>
    </div>

    <div class="kpi-card" style="<%= (metrics.backedOut || 0) > 0 ? 'border-color: #ef4444; background: rgba(239, 68, 68, 0.08);' : '' %>">
      <div class="kpi-header">
        <span class="kpi-title" style="<%= (metrics.backedOut || 0) > 0 ? 'color: #fca5a5;' : '' %>">Backed Out</span>
        <div class="kpi-icon" style="background: rgba(239, 68, 68, 0.2); color: #ef4444;"><i class="fa-solid fa-user-xmark"></i></div>
      </div>
      <div class="kpi-value" style="color: #ef4444;"><%= metrics.backedOut || 0 %></div>
      <p style="margin: 8px 0 0 0; font-size: 0.78rem; color: var(--admin-text-muted);">Reported Backouts</p>
    </div>
  </div>

  <!-- Quick Overview Row -->
  <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px;">
    <h2 style="font-size: 1.3rem; margin: 0; color: #fff; font-family: 'Plus Jakarta Sans', sans-serif;">
      Recent Candidate Applications
    </h2>
    <a href="/admin/leads" style="color: var(--admin-gold); text-decoration: none; font-size: 0.9rem; font-weight: 600;">
      View All Candidates &rarr;
    </a>
  </div>

  <!-- Recent Leads Table -->
  <div class="table-card">
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Ref #</th>
            <th>Candidate</th>
            <th>Phone / WhatsApp</th>
            <th>Type</th>
            <th>Primary Trade</th>
            <th>Dossier PDF</th>
            <th>Status</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentLeads && recentLeads.length > 0) { %>
            <% recentLeads.forEach(lead => { %>
              <tr>
                <td>
                  <strong style="font-family: 'Space Grotesk', monospace; color: var(--admin-gold);">#NG-<%= lead.id %></strong>
                </td>
                <td>
                  <div style="font-weight: 600; color: #fff;"><%= lead.full_name %></div>
                  <small style="color: var(--admin-text-muted);"><%= lead.city %></small>
                </td>
                <td>
                  <a href="https://wa.me/<%= lead.phone.replace(/[^0-9]/g, '') %>" target="_blank" style="color: #34D399; text-decoration: none; display: inline-flex; align-items: center; gap: 6px;">
                    <i class="fa-brands fa-whatsapp"></i>
                    <span><%= lead.phone %></span>
                  </a>
                </td>
                <td>
                  <% if (lead.lead_type === 'confirmed_candidate') { %>
                    <span style="background: rgba(212, 175, 55, 0.15); color: var(--admin-gold); font-size: 0.72rem; padding: 2px 7px; border-radius: 4px; font-weight: 600;">
                      <i class="fa-solid fa-check-double"></i> Confirmed
                    </span>
                  <% } else { %>
                    <span style="background: rgba(56, 189, 248, 0.15); color: var(--admin-cyan); font-size: 0.72rem; padding: 2px 7px; border-radius: 4px; font-weight: 600;">
                      <i class="fa-solid fa-comment-dots"></i> Query Lead
                    </span>
                  <% } %>
                </td>
                <td>
                  <div style="font-weight: 500;"><%= lead.trade %></div>
                  <small style="color: var(--admin-text-muted);"><%= lead.destination %></small>
                </td>
                <td>
                  <% if (lead.merged_dossier_pdf) { %>
                    <a href="<%= lead.merged_dossier_pdf %>" target="_blank" style="color: #34d399; text-decoration: none; font-size: 0.78rem; display: inline-flex; align-items: center; gap: 4px; font-weight: 600;">
                      <i class="fa-solid fa-file-pdf"></i>
                      <span>Dossier Ready</span>
                    </a>
                  <% } else { %>
                    <span style="color: var(--admin-text-muted); font-size: 0.76rem;">Pending Docs</span>
                  <% } %>
                </td>
                <td>
                  <% 
                    let statusClass = 'new';
                    if (lead.status === 'Contacted') statusClass = 'contacted';
                    else if (lead.status === 'In-Progress') statusClass = 'in-progress';
                    else if (lead.status === 'Placed') statusClass = 'placed';
                    else if (lead.status === 'Backed Out') statusClass = 'error';
                    else if (lead.status === 'Confirmed') statusClass = 'contacted';
                  %>
                  <span class="status-badge <%= statusClass %>"><%= lead.status %></span>
                </td>
                <td style="text-align: right;">
                  <a href="/admin/leads/<%= lead.id %>" class="btn-admin btn-admin-secondary" style="padding: 6px 12px; font-size: 0.82rem;">
                    <i class="fa-solid fa-folder-open"></i>
                    <span>Dossier</span>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" style="text-align: center; padding: 40px; color: var(--admin-text-muted);">
                No candidate leads found. New applications from the website wizard will appear here automatically.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Quick Navigation Highlights -->
  <div style="margin-top: 36px; display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px;">
    
    <div class="card-panel">
      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 12px;">
        <div class="kpi-icon icon-gold"><i class="fa-solid fa-briefcase"></i></div>
        <div>
          <h3 style="margin: 0; color: #fff; font-size: 1.1rem;">Active Overseas Quotas</h3>
          <p style="margin: 0; color: var(--admin-text-muted); font-size: 0.85rem;"><%= activeJobsCount %> verified job openings live</p>
        </div>
      </div>
      <p style="color: var(--admin-text-muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 16px;">
        Manage employer openings for Saudi Arabia, UAE, Qatar, Germany, USA, and New Zealand.
      </p>
      <a href="/admin/jobs" class="btn-admin btn-admin-secondary" style="width: 100%; justify-content: center;">
        <span>Manage Job Quotas</span>
      </a>
    </div>

    <div class="card-panel">
      <div style="display: flex; align-items: center; gap: 14px; margin-bottom: 12px;">
        <div class="kpi-icon icon-emerald"><i class="fa-solid fa-sliders"></i></div>
        <div>
          <h3 style="margin: 0; color: #fff; font-size: 1.1rem;">Routing & Helpline</h3>
          <p style="margin: 0; color: var(--admin-text-muted); font-size: 0.85rem;">WhatsApp & Anti-Fraud config</p>
        </div>
      </div>
      <p style="color: var(--admin-text-muted); font-size: 0.9rem; line-height: 1.6; margin-bottom: 16px;">
        Configure candidate helpline phone numbers, WhatsApp routing desks, and advisory notices.
      </p>
      <a href="/admin/settings" class="btn-admin btn-admin-secondary" style="width: 100%; justify-content: center;">
        <span>Platform Settings</span>
      </a>
    </div>

  </div>

</main>

</body>
</html>
