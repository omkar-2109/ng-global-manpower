<%- include('../partials/admin-header') %>

<main class="admin-container">

  <div class="admin-page-header">
    <div class="admin-page-title">
      <h1>Verified Overseas Job Quotas</h1>
      <p>Manage employer openings displayed on the public website and candidate search directory.</p>
    </div>
    <div style="display: flex; gap: 10px;">
      <a href="/admin/jobs/new" class="btn-admin btn-admin-primary" style="background: linear-gradient(135deg, #6366f1 0%, #a855f7 100%); border: none; box-shadow: 0 4px 15px rgba(168, 85, 247, 0.4);">
        <i class="fa-solid fa-wand-magic-sparkles"></i>
        <span>⚡ Generate with Qwen AI</span>
      </a>
      <a href="/admin/jobs/new" class="btn-admin btn-admin-primary">
        <i class="fa-solid fa-plus"></i>
        <span>Create Job Quota</span>
      </a>
    </div>
  </div>

  <!-- Jobs Table -->
  <div class="table-card">
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Quota ID</th>
            <th>Job Title & Category</th>
            <th>Country / Region</th>
            <th>Offered Salary</th>
            <th>Perks & Amenities</th>
            <th>Model</th>
            <th>Status</th>
            <th style="text-align: right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (jobs && jobs.length > 0) { %>
            <% jobs.forEach(job => { %>
              <tr>
                <td>
                  <strong style="font-family: 'Space Grotesk', monospace; color: var(--admin-gold);"><%= job.job_code %></strong>
                </td>
                <td>
                  <div style="font-weight: 600; color: #fff;"><%= job.title %></div>
                  <small style="color: var(--admin-text-muted);"><%= job.category %></small>
                </td>
                <td>
                  <span style="margin-right: 6px;"><%= job.flag || '🌐' %></span>
                  <span><%= job.country %></span>
                </td>
                <td>
                  <div style="font-weight: 600; color: #fff;"><%= job.salary_inr %></div>
                  <% if (job.salary_foreign) { %>
                    <small style="color: var(--admin-cyan);"><%= job.salary_foreign %></small>
                  <% } %>
                </td>
                <td>
                  <div style="display: flex; gap: 4px; flex-wrap: wrap;">
                    <% (job.perks || []).slice(0, 2).forEach(p => { %>
                      <span style="background: rgba(255, 255, 255, 0.06); padding: 2px 8px; border-radius: 4px; font-size: 0.78rem;"><%= p %></span>
                    <% }); %>
                    <% if ((job.perks || []).length > 2) { %>
                      <span style="color: var(--admin-text-muted); font-size: 0.78rem;">+<%= job.perks.length - 2 %> more</span>
                    <% } %>
                  </div>
                </td>
                <td>
                  <% if (job.employer_funded) { %>
                    <span style="color: #34D399; font-weight: 600; font-size: 0.82rem;"><i class="fa-solid fa-gift"></i> 100% Funded</span>
                  <% } else { %>
                    <span style="color: var(--admin-text-muted); font-size: 0.82rem;">Direct Embassy</span>
                  <% } %>
                </td>
                <td>
                  <% if (job.active) { %>
                    <span class="status-badge placed">Active</span>
                  <% } else { %>
                    <span class="status-badge" style="background: rgba(255, 255, 255, 0.08); color: var(--admin-text-muted);">Draft</span>
                  <% } %>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <a href="/admin/jobs/<%= job.id %>/edit" class="btn-admin btn-admin-secondary" style="padding: 6px 12px; font-size: 0.82rem;">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>Edit</span>
                  </a>

                  <form action="/admin/jobs/<%= job.id %>/delete" method="POST" style="display: inline-block; margin-left: 6px;" onsubmit="return confirm('Are you sure you want to delete this job opening?');">
                    <button type="submit" class="btn-admin btn-admin-danger" style="padding: 6px 10px; font-size: 0.82rem;">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="8" style="text-align: center; padding: 40px; color: var(--admin-text-muted);">
                No job quotas created yet. Click "Create New Job Quota" to add your first opening.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</main>

</body>
</html>
