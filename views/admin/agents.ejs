<%- include('../partials/admin-header') %>

<main class="admin-container">

  <div class="admin-page-header">
    <div class="admin-page-title">
      <h1>Authorized Recruitment Partner Agents</h1>
      <p>Manage licensed sub-agents, branch credentials, candidate quotas, and dedicated agency subdomains.</p>
    </div>
    <div>
      <a href="/admin/agents/new" class="btn-admin btn-admin-primary">
        <i class="fa-solid fa-user-plus"></i>
        <span>Register New Partner Agent</span>
      </a>
    </div>
  </div>

  <% if (typeof passwordReset !== 'undefined' && passwordReset) { %>
    <div class="admin-alert admin-alert-success" style="margin-bottom: 20px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; padding: 14px 18px; border-radius: 8px; display: flex; align-items: center; gap: 10px;">
      <i class="fa-solid fa-circle-check" style="font-size: 1.2rem;"></i>
      <div>
        <strong style="color: #fff;">Password Updated Successfully!</strong>
        <div style="font-size: 0.85rem; margin-top: 2px;">The recruitment partner agent's credentials have been updated and are live immediately for login.</div>
      </div>
    </div>
  <% } %>

  <% if (typeof updated !== 'undefined' && updated && !passwordReset) { %>
    <div class="admin-alert admin-alert-success" style="margin-bottom: 20px; background: rgba(59, 130, 246, 0.15); border: 1px solid rgba(59, 130, 246, 0.4); color: #60a5fa; padding: 12px 16px; border-radius: 8px; display: flex; align-items: center; gap: 10px;">
      <i class="fa-solid fa-circle-check"></i>
      <span>Partner agent details saved successfully.</span>
    </div>
  <% } %>

  <% if (typeof created !== 'undefined' && created) { %>
    <div class="admin-alert admin-alert-success" style="margin-bottom: 20px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.4); color: #34d399; padding: 12px 16px; border-radius: 8px; display: flex; align-items: center; gap: 10px;">
      <i class="fa-solid fa-circle-check"></i>
      <span>New recruitment partner agent registered successfully!</span>
    </div>
  <% } %>

  <% if (typeof deleted !== 'undefined' && deleted) { %>
    <div class="admin-alert admin-alert-error" style="margin-bottom: 20px; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; padding: 12px 16px; border-radius: 8px; display: flex; align-items: center; gap: 10px;">
      <i class="fa-solid fa-trash-can"></i>
      <span>Partner agent removed.</span>
    </div>
  <% } %>

  <% if (typeof error !== 'undefined' && error) { %>
    <div class="admin-alert admin-alert-error" style="margin-bottom: 20px; background: rgba(239, 68, 68, 0.15); border: 1px solid rgba(239, 68, 68, 0.4); color: #f87171; padding: 14px 18px; border-radius: 8px; display: flex; align-items: center; gap: 10px;">
      <i class="fa-solid fa-triangle-exclamation" style="font-size: 1.2rem;"></i>
      <span><%= error %></span>
    </div>
  <% } %>

  <!-- Agent Summary Metrics -->
  <div class="metrics-grid" style="grid-template-columns: repeat(3, 1fr); margin-bottom: 24px;">
    <div class="metric-card">
      <div class="metric-card-header">
        <span class="metric-label">Active Partner Agencies</span>
        <div class="metric-icon" style="background: rgba(59, 130, 246, 0.15); color: #60a5fa;">
          <i class="fa-solid fa-handshake"></i>
        </div>
      </div>
      <div class="metric-value"><%= (agents || []).filter(a => a.status === 'active').length %></div>
      <div class="metric-subtitle">Authorized sourcing channels</div>
    </div>

    <div class="metric-card">
      <div class="metric-card-header">
        <span class="metric-label">Total Partner Candidates</span>
        <div class="metric-icon" style="background: rgba(16, 185, 129, 0.15); color: #34d399;">
          <i class="fa-solid fa-users-viewfinder"></i>
        </div>
      </div>
      <div class="metric-value">
        <%= (agents || []).reduce((sum, a) => sum + (a.candidates_count || 0), 0) %>
      </div>
      <div class="metric-subtitle">Dossiers submitted via agents</div>
    </div>

    <div class="metric-card">
      <div class="metric-card-header">
        <span class="metric-label">Dedicated Subdomains</span>
        <div class="metric-icon" style="background: rgba(212, 175, 55, 0.15); color: var(--admin-gold);">
          <i class="fa-solid fa-globe"></i>
        </div>
      </div>
      <div class="metric-value"><%= (agents || []).length %></div>
      <div class="metric-subtitle">Live agency landing URLs</div>
    </div>
  </div>

  <!-- Agents Table -->
  <div class="table-card">
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Agency / Agent Name</th>
            <th>Subdomain & Login Handle</th>
            <th>Contact & Location</th>
            <th>License / Reg No</th>
            <th>Candidates</th>
            <th>Status</th>
            <th style="text-align: right;">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (agents && agents.length > 0) { %>
            <% agents.forEach(agent => { %>
              <tr>
                <td>
                  <div style="font-weight: 700; color: #fff; font-size: 0.95rem;">
                    <%= agent.agency_name || agent.name %>
                  </div>
                  <div style="font-size: 0.8rem; color: var(--admin-text-muted);">
                    <i class="fa-solid fa-user-tie" style="margin-right: 4px;"></i> <%= agent.name %>
                  </div>
                </td>
                <td>
                  <div style="font-family: monospace; color: var(--admin-gold); font-size: 0.85rem; font-weight: 600;">
                    <%= agent.username %>
                  </div>
                  <div style="margin-top: 4px;">
                    <a href="<%= typeof getAgentLandingUrl === 'function' ? getAgentLandingUrl(agent.username) : ('/agency/' + agent.username) %>" target="_blank" style="font-size: 0.78rem; color: var(--admin-cyan); text-decoration: none;">
                      <i class="fa-solid fa-up-right-from-square"></i> <%= agent.username %>.<%= typeof rootHostname !== 'undefined' ? rootHostname : 'ngglobalmp.in' %>
                    </a>
                  </div>
                </td>
                <td>
                  <div style="color: #fff; font-size: 0.85rem;">
                    <i class="fa-solid fa-phone" style="margin-right: 4px; color: var(--admin-gold);"></i> <%= agent.phone || 'N/A' %>
                  </div>
                  <div style="font-size: 0.8rem; color: var(--admin-text-muted);">
                    <%= agent.email %>
                  </div>
                  <% if (agent.city || agent.state) { %>
                    <div style="font-size: 0.75rem; color: var(--admin-text-muted); margin-top: 2px;">
                      📍 <%= [agent.city, agent.state, agent.country].filter(Boolean).join(', ') %>
                    </div>
                  <% } %>
                </td>
                <td>
                  <span style="font-family: monospace; font-size: 0.8rem; color: #e2e8f0; background: rgba(255, 255, 255, 0.05); padding: 2px 6px; border-radius: 4px;">
                    <%= agent.license_no || 'Pending Verification' %>
                  </span>
                </td>
                <td>
                  <span style="font-size: 1rem; font-weight: 700; color: #34d399;">
                    <%= agent.candidates_count || 0 %>
                  </span>
                  <div style="font-size: 0.75rem; color: var(--admin-text-muted);">dossiers</div>
                </td>
                <td>
                  <% if (agent.status === 'active') { %>
                    <span class="status-badge placed">Active</span>
                  <% } else { %>
                    <span class="status-badge" style="background: rgba(239, 68, 68, 0.2); color: #f87171;">Suspended</span>
                  <% } %>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <button type="button" class="btn-admin btn-admin-secondary" style="padding: 6px 10px; font-size: 0.82rem; margin-right: 4px; color: #f59e0b; border-color: rgba(245, 158, 11, 0.4);" onclick="openResetModal('<%= agent.id %>', '<%= (agent.agency_name || agent.name).replace(/'/g, '\\\'') %>', '<%= agent.username %>')" title="Reset Agent Password">
                    <i class="fa-solid fa-key"></i>
                    <span>Reset Pass</span>
                  </button>

                  <a href="/admin/agents/<%= agent.id %>/edit" class="btn-admin btn-admin-secondary" style="padding: 6px 12px; font-size: 0.82rem;">
                    <i class="fa-solid fa-pen-to-square"></i>
                    <span>Edit</span>
                  </a>

                  <form action="/admin/agents/<%= agent.id %>/delete" method="POST" style="display: inline-block; margin-left: 6px;" onsubmit="return confirm('Are you sure you want to deactivate and remove this agent partner?');">
                    <button type="submit" class="btn-admin btn-admin-danger" style="padding: 6px 10px; font-size: 0.82rem;" title="Delete Agent">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </form>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" style="text-align: center; padding: 40px; color: var(--admin-text-muted);">
                No recruitment partner agents registered yet. Click "Register New Partner Agent" to create credentials.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

</main>

<!-- Interactive Password Reset Modal -->
<div id="resetPasswordModal" style="display: none; position: fixed; inset: 0; background: rgba(3, 10, 26, 0.85); backdrop-filter: blur(8px); z-index: 9999; align-items: center; justify-content: center; padding: 20px;">
  <div style="background: #081636; border: 1.5px solid var(--admin-gold); border-radius: 14px; max-width: 460px; width: 100%; padding: 28px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6); position: relative;">
    <button type="button" onclick="closeResetModal()" style="position: absolute; top: 18px; right: 18px; background: none; border: none; color: var(--admin-text-muted); font-size: 1.2rem; cursor: pointer;">
      <i class="fa-solid fa-xmark"></i>
    </button>
    <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
      <div style="width: 42px; height: 42px; border-radius: 10px; background: rgba(245, 158, 11, 0.15); display: flex; align-items: center; justify-content: center; color: #f59e0b; font-size: 1.2rem;">
        <i class="fa-solid fa-key"></i>
      </div>
      <div>
        <h3 style="color: #fff; font-size: 1.15rem; margin: 0;">Reset Agent Password</h3>
        <p style="color: var(--admin-text-muted); font-size: 0.82rem; margin: 2px 0 0 0;">Agent: <strong id="modalAgentName" style="color: var(--admin-gold);"></strong> (<span id="modalAgentHandle" style="font-family: monospace;"></span>)</p>
      </div>
    </div>

    <form id="resetPasswordForm" method="POST" action="">
      <div class="form-group" style="margin-bottom: 18px;">
        <label class="form-label" for="modalNewPassword" style="font-size: 0.85rem; color: #cbd5e1; display: block; margin-bottom: 6px;">New Secure Password *</label>
        <div style="position: relative;">
          <input type="password" id="modalNewPassword" name="new_password" class="form-control" placeholder="Minimum 6 characters" required minlength="6" style="width: 100%; padding-right: 75px;" />
          <button type="button" onclick="toggleModalPassword()" style="position: absolute; right: 40px; top: 10px; background: none; border: none; color: var(--admin-text-muted); cursor: pointer;" title="Show/Hide">
            <i id="toggleEyeIcon" class="fa-solid fa-eye"></i>
          </button>
          <button type="button" onclick="generateRandomPassword()" style="position: absolute; right: 10px; top: 10px; background: none; border: none; color: var(--admin-gold); cursor: pointer;" title="Generate Random Secure Password">
            <i class="fa-solid fa-wand-magic-sparkles"></i>
          </button>
        </div>
        <small style="color: var(--admin-text-muted); font-size: 0.76rem; display: block; margin-top: 4px;">Click the magic wand to auto-generate a strong password.</small>
      </div>

      <div style="display: flex; gap: 10px; justify-content: flex-end; margin-top: 24px;">
        <button type="button" onclick="closeResetModal()" class="btn-admin btn-admin-secondary" style="padding: 10px 18px;">Cancel</button>
        <button type="submit" class="btn-admin btn-admin-primary" style="padding: 10px 22px;">
          <i class="fa-solid fa-check"></i>
          <span>Save New Password</span>
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  function openResetModal(agentId, agentName, agentUsername) {
    document.getElementById('modalAgentName').textContent = agentName;
    document.getElementById('modalAgentHandle').textContent = agentUsername;
    document.getElementById('resetPasswordForm').action = '/admin/agents/' + agentId + '/reset-password';
    document.getElementById('modalNewPassword').value = '';
    document.getElementById('modalNewPassword').type = 'password';
    document.getElementById('toggleEyeIcon').className = 'fa-solid fa-eye';
    const modal = document.getElementById('resetPasswordModal');
    modal.style.display = 'flex';
  }

  function closeResetModal() {
    document.getElementById('resetPasswordModal').style.display = 'none';
  }

  function toggleModalPassword() {
    const input = document.getElementById('modalNewPassword');
    const icon = document.getElementById('toggleEyeIcon');
    if (input.type === 'password') {
      input.type = 'text';
      icon.className = 'fa-solid fa-eye-slash';
    } else {
      input.type = 'password';
      icon.className = 'fa-solid fa-eye';
    }
  }

  function generateRandomPassword() {
    const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789@#%';
    let pass = '';
    for (let i = 0; i < 10; i++) {
      pass += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    const input = document.getElementById('modalNewPassword');
    input.type = 'text';
    input.value = pass;
    document.getElementById('toggleEyeIcon').className = 'fa-solid fa-eye-slash';
  }

  // Close modal on escape key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeResetModal();
  });
</script>

</body>
</html>
