<%- include('../partials/admin-header') %>

<main class="admin-container">
  
  <div class="admin-page-header">
    <div class="admin-page-title">
      <h1>Candidate Application Dossiers</h1>
      <p>Filter, evaluate trade credentials, and coordinate official embassy visa processing.</p>
    </div>
    <div style="display: flex; gap: 12px;">
      <a href="/admin/leads/export" class="btn-admin btn-admin-primary">
        <i class="fa-solid fa-download"></i>
        <span>Download CSV Roster</span>
      </a>
    </div>
  </div>

  <!-- Pipeline Mode Switcher Tabs -->
  <div style="display: flex; gap: 8px; margin-bottom: 18px; flex-wrap: wrap;">
    <a href="/admin/leads" class="btn-admin <%= !filter || (!filter.lead_type && !filter.status) ? 'btn-admin-primary' : 'btn-admin-secondary' %>" style="padding: 8px 16px; font-size: 0.85rem;">
      <i class="fa-solid fa-list-check"></i>
      <span>All Candidates (<%= metrics.total %>)</span>
    </a>

    <a href="/admin/leads?lead_type=confirmed_candidate" class="btn-admin <%= filter && filter.lead_type === 'confirmed_candidate' ? 'btn-admin-primary' : 'btn-admin-secondary' %>" style="padding: 8px 16px; font-size: 0.85rem;">
      <i class="fa-solid fa-badge-check" style="color: var(--admin-gold);"></i>
      <span>Confirmed Candidates (<%= metrics.confirmed || 0 %>)</span>
    </a>

    <a href="/admin/leads?lead_type=inquiry_lead" class="btn-admin <%= filter && filter.lead_type === 'inquiry_lead' ? 'btn-admin-primary' : 'btn-admin-secondary' %>" style="padding: 8px 16px; font-size: 0.85rem;">
      <i class="fa-solid fa-comments" style="color: var(--admin-cyan);"></i>
      <span>Inquiry Leads / Queries (<%= metrics.inquiries || 0 %>)</span>
    </a>

    <a href="/admin/leads?status=Backed+Out" class="btn-admin <%= filter && filter.status && filter.status.toLowerCase() === 'backed out' ? 'btn-admin-danger' : 'btn-admin-secondary' %>" style="padding: 8px 16px; font-size: 0.85rem; <%= filter && filter.status && filter.status.toLowerCase() === 'backed out' ? 'background: #ef4444; color: #fff;' : 'color: #fca5a5;' %>">
      <i class="fa-solid fa-user-xmark"></i>
      <span>Backed Out Alerts (<%= metrics.backedOut || 0 %>)</span>
    </a>
  </div>

  <!-- Filter Toolbar -->
  <div class="filter-bar">
    <form action="/admin/leads" method="GET" style="display: flex; align-items: center; justify-content: space-between; width: 100%; flex-wrap: wrap; gap: 14px;">
      <% if (filter && filter.lead_type) { %>
        <input type="hidden" name="lead_type" value="<%= filter.lead_type %>" />
      <% } %>
      
      <div class="filter-group">
        <!-- Search -->
        <input 
          type="text" 
          name="search" 
          class="filter-input" 
          placeholder="Search by candidate name, phone, trade, or city..." 
          value="<%= filter && filter.search ? filter.search : '' %>" 
          style="min-width: 260px;"
        />

        <!-- Status Filter -->
        <select name="status" class="filter-select" onchange="this.form.submit()">
          <option value="">All Pipeline Stages</option>
          <option value="New" <%= filter && filter.status === 'New' ? 'selected' : '' %>>New (<%= metrics.new %>)</option>
          <option value="Contacted" <%= filter && filter.status === 'Contacted' ? 'selected' : '' %>>Contacted (<%= metrics.contacted %>)</option>
          <option value="Confirmed" <%= filter && filter.status === 'Confirmed' ? 'selected' : '' %>>Confirmed / Ready to Pay</option>
          <option value="In-Progress" <%= filter && filter.status === 'In-Progress' ? 'selected' : '' %>>In-Progress (<%= metrics.inProgress %>)</option>
          <option value="Placed" <%= filter && filter.status === 'Placed' ? 'selected' : '' %>>Placed (<%= metrics.placed %>)</option>
          <option value="Backed Out" <%= filter && filter.status === 'Backed Out' ? 'selected' : '' %>>Backed Out (<%= metrics.backedOut || 0 %>)</option>
        </select>

        <!-- Trade Filter -->
        <select name="trade" class="filter-select" onchange="this.form.submit()">
          <option value="">All Trade Categories</option>
          <option value="Construction" <%= filter && filter.trade === 'Construction' ? 'selected' : '' %>>Construction & Infrastructure</option>
          <option value="Manufacturing" <%= filter && filter.trade === 'Manufacturing' ? 'selected' : '' %>>Manufacturing & Welding</option>
          <option value="Logistics" <%= filter && filter.trade === 'Logistics' ? 'selected' : '' %>>Logistics & Heavy Driving</option>
          <option value="Electrical" <%= filter && filter.trade === 'Electrical' ? 'selected' : '' %>>Electrical & MEP</option>
          <option value="Hospitality" <%= filter && filter.trade === 'Hospitality' ? 'selected' : '' %>>Hospitality & Catering</option>
        </select>
      </div>

      <div style="display: flex; gap: 10px;">
        <button type="submit" class="btn-admin btn-admin-secondary">
          <i class="fa-solid fa-filter"></i>
          <span>Apply Filters</span>
        </button>
        <% if (filter && (filter.status || filter.trade || filter.search)) { %>
          <a href="/admin/leads" class="btn-admin btn-admin-secondary" title="Clear all filters">
            <i class="fa-solid fa-rotate-left"></i>
            <span>Reset</span>
          </a>
        <% } %>
      </div>

    </form>
  </div>

  <!-- Candidates Table -->
  <div class="table-card">
    <div class="table-responsive">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Application Ref</th>
            <th>Candidate Profile</th>
            <th>Phone / WhatsApp</th>
            <th>Type</th>
            <th>Trade & Destination</th>
            <th>Dossier PDF</th>
            <th>Registered Date</th>
            <th>Stage</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (leads && leads.length > 0) { %>
            <% leads.forEach(lead => { %>
              <tr style="<%= lead.status === 'Backed Out' ? 'background: rgba(239, 68, 68, 0.04);' : '' %>">
                <td>
                  <strong style="font-family: 'Space Grotesk', monospace; color: var(--admin-gold);">#NG-<%= lead.id %></strong>
                  <% if (lead.job_code) { %>
                    <br><small style="color: var(--admin-cyan);">Quota: <%= lead.job_code %></small>
                  <% } %>
                </td>
                <td>
                  <div style="font-weight: 600; color: #fff;"><%= lead.full_name %></div>
                  <small style="color: var(--admin-text-muted);"><i class="fa-solid fa-location-dot"></i> <%= lead.city %></small>
                </td>
                <td>
                  <a href="https://wa.me/<%= lead.phone.replace(/[^0-9]/g, '') %>" target="_blank" style="color: #34D399; text-decoration: none; font-weight: 500; display: inline-flex; align-items: center; gap: 6px;">
                    <i class="fa-brands fa-whatsapp"></i>
                    <span><%= lead.phone %></span>
                  </a>
                </td>
                <td>
                  <% if (lead.lead_type === 'confirmed_candidate') { %>
                    <span style="background: rgba(212, 175, 55, 0.15); color: var(--admin-gold); font-size: 0.75rem; padding: 3px 8px; border-radius: 4px; font-weight: 600; white-space: nowrap;">
                      <i class="fa-solid fa-check-double"></i> Confirmed
                    </span>
                  <% } else { %>
                    <span style="background: rgba(56, 189, 248, 0.15); color: var(--admin-cyan); font-size: 0.75rem; padding: 3px 8px; border-radius: 4px; font-weight: 600; white-space: nowrap;">
                      <i class="fa-solid fa-comment-dots"></i> Query Lead
                    </span>
                  <% } %>
                </td>
                <td>
                  <div style="font-weight: 500; color: #fff;"><%= lead.trade %></div>
                  <small style="color: var(--admin-text-muted);"><%= lead.destination %> &bull; <%= lead.experience %></small>
                </td>
                <td>
                  <% if (lead.merged_dossier_pdf) { %>
                    <a href="<%= lead.merged_dossier_pdf %>" target="_blank" style="color: #34d399; text-decoration: none; font-size: 0.8rem; display: inline-flex; align-items: center; gap: 5px; font-weight: 600; background: rgba(52, 211, 153, 0.1); padding: 3px 8px; border-radius: 4px; border: 1px solid rgba(52, 211, 153, 0.3);">
                      <i class="fa-solid fa-file-pdf"></i>
                      <span>Master Dossier</span>
                    </a>
                  <% } else { %>
                    <span style="color: var(--admin-text-muted); font-size: 0.78rem;">
                      <i class="fa-solid fa-clock"></i> Docs Pending
                    </span>
                  <% } %>
                </td>
                <td>
                  <small style="color: var(--admin-text-muted);">
                    <%= new Date(lead.created_at).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                  </small>
                </td>
                <td>
                  <% 
                    let statusClass = 'new';
                    if (lead.status === 'Contacted') statusClass = 'contacted';
                    else if (lead.status === 'In-Progress') statusClass = 'in-progress';
                    else if (lead.status === 'Placed') statusClass = 'placed';
                    else if (lead.status === 'Backed Out') statusClass = 'error';
                    else if (lead.status === 'Confirmed') statusClass = 'contacted';
                  %>
                  <span class="status-badge <%= statusClass %>"><%= lead.status %></span>
                  <% if (lead.status === 'Backed Out' && lead.backout_reason) { %>
                    <div style="font-size: 0.72rem; color: #fca5a5; margin-top: 3px; max-width: 140px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="<%= lead.backout_reason %>">
                      <%= lead.backout_reason %>
                    </div>
                  <% } %>
                </td>
                <td style="text-align: right; white-space: nowrap;">
                  <a href="/admin/leads/<%= lead.id %>" class="btn-admin btn-admin-secondary" style="padding: 6px 12px; font-size: 0.82rem;">
                    <i class="fa-solid fa-folder-open"></i>
                    <span>Dossier & Docs</span>
                  </a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="9" style="text-align: center; padding: 50px 20px; color: var(--admin-text-muted);">
                <i class="fa-solid fa-user-slash" style="font-size: 2.5rem; margin-bottom: 12px; color: var(--admin-border-gold);"></i>
                <p style="margin: 0; font-size: 1rem; color: #fff;">No candidate records found matching this criteria.</p>
                <small>Try clearing your filters or check back once candidates complete the eligibility funnel.</small>
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <div style="margin-top: 16px; color: var(--admin-text-muted); font-size: 0.85rem;">
    Displaying <%= leads.length %> candidate records
  </div>

</main>

</body>
</html>
