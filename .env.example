# Server Configuration
PORT=3000
NODE_ENV=development
APP_NAME="NG Global Manpower Services"
APP_URL=http://localhost:3000

# Security & JWT
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d
COOKIE_SECRET=your_cookie_secret_key_2026

# Database
DB_FILE=./data/ngglobal.sqlite

# Recruitment Helpline & WhatsApp
WHATSAPP_NUMBER=918080025670
HELPLINE_PHONE="+91 80800 25670"
